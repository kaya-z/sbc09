0000:                                  IFNE      COCO.D-1
0001:                   COCO.D         SET       1
0000:                   
0000:                   ********************************************************************
0000:                   * CoCoDefs - NitrOS-9 System Definitions for the Tandy Color Computer
0000:                   *
0000:                   * $Id$
0000:                   *
0000:                   * Edt/Rev  YYYY/MM/DD  Modified by
0000:                   * Comment
0000:                   * ------------------------------------------------------------------
0000:                   *          1998/10/13  Boisy G. Pitre
0000:                   * Added defs by Bruce Isted from his Eliminator archive.
0000:                   *
0000:                   *          1998/10/31  Boisy G. Pitre
0000:                   * Merged cc3global.defs into this file.
0000:                   *
0000:                   *          2002/04/30  Boisy G. Pitre
0000:                   * Merged Level One and Level Two sysdefs.
0000:                   *
0000:                   *          2002/06/22  Boisy G. Pitre
0000:                   * Removed PIA.U4 and PIA.U8, improved comments
0000:                   *
0000:                   *          2003/11/05  Robert Gault
0000:                   * Made changes in window globals and grfdrv memory to handle regW
0000:                   * in 6809 systems.
0000:                   *
0000:                   *          2003/11/30  Boisy G. Pitre
0000:                   * Statics now are prefaced with V. to identify them easier in source.
0000:                   *
0000:                   *          2004/07/18  Boisy G. Pitre
0000:                   * Moved CoCo 3 Window stuff into cc3iodefs
0000:                   *
0000:                   *          2012/02/24  Boisy G. Pitre
0000:                   * Consolidated all CoCo-specific defs files into here.
0000:                   
0000:                                  NAM       CoCoDefs
0000:                                  IFEQ      Level-1
0000:                                  TTL       NitrOS-9 System Definitions for the Tandy Color Computer
0000:                                  ELSE      
0000:                                  IFEQ      Level-2
0000:                                  TTL       NitrOS-9 Level 2 System Type Definitions
0000:                                  ELSE      
0000:                                  IFEQ      Level-3
0000:                                  TTL       NitrOS-9 Level 3 System Type Definitions
0000:                                  ENDC      
0000:                                  ENDC      
0000:                                  ENDC      
0000:                   
0000:                   
0000:                   **********************
0000:                   * CPU Type Definitions
0000:                   *
0001:                   Color          SET       1
0002:                   Color3         SET       2
0000:                                  IFEQ      Level-1
0002:                   CPUType        SET       Color
0000:                                  ELSE      
0002:                   CPUType        SET       Color3
0000:                                  ENDC      
0000:                   
0000:                   
0000:                   ******************************
0000:                   * Clock Speed Type Definitions
0000:                   *
0001:                   OneMHz         EQU       1
0002:                   TwoMHz         EQU       2
0000:                                  IFEQ      CPUType-Color
0002:                   CPUSpeed       SET       OneMHz
0000:                                  ELSE      
0002:                   CPUSpeed       SET       TwoMHz
0000:                                  ENDC      
0000:                   
0000:                   
0000:                   **********************************
0000:                   * Power Line Frequency Definitions
0000:                   *
0001:                   Hz50           EQU       1                   Assemble clock for 50 hz power
0002:                   Hz60           EQU       2                   Assemble clock for 60 hz power
0000:                                  IFNDEF    PwrLnFrq
0002:                   PwrLnFrq       SET       Hz60                Set to Appropriate freq
0000:                                  ENDC
0000:                   
0000:                   
0000:                   **********************************
0000:                   * Ticks per second
0000:                   *
0000:                                  IFNDEF    TkPerSec
0000:                                  IFEQ      PwrLnFrq-Hz50
003C:                   TkPerSec       SET       50
0000:                                  ELSE      
003C:                   TkPerSec       SET       60
0000:                                  ENDC      
0000:                                  ENDC
0000:                   
0000:                   
0000:                   ******************
0000:                   * ACIA type set up
0000:                   *
0000:                                  ORG       1
0001:                   ACIA6850       RMB       1                   MC6850 acia.
0002:                   ACIA6551       RMB       1                   SY6551 acia.
0003:                   ACIA2661       RMB       1                   SC2661 acia.
0002:                   ACIATYPE       SET       ACIA6551
0000:                   
0000:                   
0000:                   ****************************************
0000:                   * Special character Bit position equates
0000:                   *
0001:                   SHIFTBIT       EQU       %00000001
0002:                   CNTRLBIT       EQU       %00000010
0004:                   ALTERBIT       EQU       %00000100
0008:                   UPBIT          EQU       %00001000
0010:                   DOWNBIT        EQU       %00010000
0020:                   LEFTBIT        EQU       %00100000
0040:                   RIGHTBIT       EQU       %01000000
0080:                   SPACEBIT       EQU       %10000000
0000:                   
0000:                   
0000:                   ******************
0000:                   * Device addresses for miscellaneous hardware
0000:                   *
FF68:                   A.AciaP        SET       $FF68               Aciapak Address
FF6C:                   A.ModP         SET       $FF6C               ModPak Address
FF40:                   DPort          SET       $FF40               Disk controller base address
FF7F:                   MPI.Slct       SET       $FF7F               Multi-Pak slot select
0003:                   MPI.Slot       SET       $03                 Multi-Pak default slot
FF00:                   PIA0Base       EQU       $FF00
FF20:                   PIA1Base       EQU       $FF20
0000:                   
0000:                   
0000:                   ******************
0000:                   * VDG Devices
0000:                   *
FFC0:                   A.TermV        SET       $FFC0               VDG Term
FFC1:                   A.V1           SET       $FFC1               Possible additional VDG Devices
FFC2:                   A.V2           SET       $FFC2
FFC3:                   A.V3           SET       $FFC3
FFC4:                   A.V4           SET       $FFC4
FFC5:                   A.V5           SET       $FFC5
FFC6:                   A.V6           SET       $FFC6
FFC7:                   A.V7           SET       $FFC7
0000:                   
0000:                   
0000:                                  IFEQ      Level-1
0000:                   
0000:                   ********************************
0000:                   * Boot defs for NitrOS-9 Level 1
0000:                   *
0000:                   * These defs are not strictly for 'Boot', but are for booting the
0000:                   * system.
0000:                   *
ED00:                   Bt.Start       EQU       $EE00               Start address of the boot track in memory
0000:                   
0000:                                  ELSE
0000:                   
0000:                   ******************************************
0000:                   * Boot defs for NitrOS-9 Level 2 and above
0000:                   *
0000:                   * These defs are not strictly for 'Boot', but are for booting the
0000:                   * system.
0000:                   *
ED00:                   Bt.Start       SET       $ED00               Start address of the boot track in memory
003B:                   Bt.Block       EQU       $3B                 Block to map in for the 'OS9BOOT' screen
8A34:                   Bt.Flag        EQU       $8A34               Flag in Bt.Block to verify that it's unchanged
0002:                   Bt.Offst       EQU       2                   Offset into the screen where the current ptr is
0000:                   
0000:                                  ENDC
0000:                   
0000:                   * On the CoCo, the boot track is all of track 34
0000:                   
0022:                   Bt.Track       EQU       34                  Boot track
0000:                   Bt.Sec         EQU       0                   Start LSN of boot area on boot track
0000:                   
0000:                   
1080:                   Bt.Size        EQU       $1080               Maximum size of bootfile
0000:                   
0000:                   
0000:                                  IFEQ      Level-1
0000:                   
0000:                   *************************************************
0000:                   *
0000:                   * NitrOS-9 Level 1 Section
0000:                   *
0000:                   *************************************************
0000:                   
0007:                   HW.Page        SET       $FF                 Device descriptor hardware page
0000:                   
0000:                                  ELSE      
0000:                   
0000:                   *************************************************
0000:                   *
0000:                   * NitrOS-9 Level 2 Section
0000:                   *
0000:                   *************************************************
0000:                   
0000:                   ****************************************
0000:                   * Dynamic Address Translator Definitions
0000:                   *
0008:                   DAT.BlCt       EQU       8                   D.A.T. blocks/address space
2000:                   DAT.BlSz       EQU       (256/DAT.BlCt)*256  D.A.T. block size
0010:                   DAT.ImSz       EQU       DAT.BlCt*2          D.A.T. Image size
FFE0:                   DAT.Addr       EQU       -(DAT.BlSz/256)     D.A.T. MSB Address bits
FF91:                   DAT.Task       EQU       $FF91               Task Register address
0020:                   DAT.TkCt       EQU       32                  Number of DAT Tasks
FFA0:                   DAT.Regs       EQU       $FFA0               DAT Block Registers base address
333E:                   DAT.Free       EQU       $333E               Free Block Number
003F:                   DAT.BlMx       EQU       $3F                 Maximum Block number
0040:                   DAT.BMSz       EQU       $40                 Memory Block Map size
0000:                   DAT.WrPr       EQU       0                   no write protect
0000:                   DAT.WrEn       EQU       0                   no write enable
0000:                   SysTask        EQU       0                   Coco System Task number
003F:                   IOBlock        EQU       $3F
003F:                   ROMBlock       EQU       $3F
007F:                   IOAddr         EQU       $7F
0001:                   ROMCount       EQU       1                   number of blocks of ROM (High RAM Block)
0001:                   RAMCount       EQU       1                   initial blocks of RAM
0005:                   MoveBlks       EQU       DAT.BlCt-ROMCount-2 Block numbers used for copies
0001:                   BlockTyp       EQU       1                   chk only first bytes of RAM block
0002:                   ByteType       EQU       2                   chk entire block of RAM
0001:                   Limited        EQU       1                   chk only upper memory for ROM modules
0002:                   UnLimitd       EQU       2                   chk all NotRAM for modules
0000:                   * NOTE: this check assumes any NotRAM with a module will
0000:                   *       always start with $87CD in first two bytes of block
0001:                   RAMCheck       EQU       BlockTyp            chk only beg bytes of block
0001:                   ROMCheck       EQU       Limited             chk only upper few blocks for ROM
003F:                   LastRAM        EQU       IOBlock             maximum RAM block number
0000:                   
0000:                   ***************************
0000:                   * Color Computer 3 Specific
0000:                   *
0000:                   MappedIO       EQU       true                (Actually False but it works better this way)
0000:                   
0000:                   ********************
0000:                   * Hardware addresses
0000:                   *
FF00:                   GIMERegs       EQU       $FF00               Base address of GIME registers
FF92:                   IrqEnR         EQU       $FF92               GIME IRQ enable/status register
FF9A:                   BordReg        EQU       $FF9A               Border color register
FFB0:                   PalAdr         EQU       $FFB0               Palette registers
0000:                   
0007:                   HW.Page        SET       $07                 Device descriptor hardware page
0000:                   
0000:                   * KrnBlk defines the block number of the 8K RAM block that is mapped to
0000:                   * the top of CPU address space ($E000-$FFFF) for the system process, and
0000:                   * which holds the Kernel. The top 2 pages of this CPU address space ($FFE0-
0000:                   * $FFFF) has two special properties. Firstly, it contains the I/O space.
0000:                   * Secondly, the parts that contain RAM map are not affected by the DAT
0000:                   * mappings but, instead, *always* map that RAM to a fixed RAM block
0000:                   * (KrnBlk). When a user process is mapped in, and requests enough memory,
0000:                   * it will end up with its own block assigned for CPU address space $E000-
0000:                   * $FFFF but the top of the address space is unusable by the user process:
0000:                   * it still contains the I/O and the bit of RAM that's mapped to KrnBlk.
0000:                   * Usually, the value of KrnBlk is fixed for a particular hardware design;
0000:                   * For the COCO GIME, it's always $3F.
003F:                   KrnBlk         SET       $3F
0000:                   
0000:                                  ENDC
0000:                                  ENDC
0000:                   
0000:                   ********************************************************************
0000:                   * Krn - NitrOS-9 Level 1 Kernel
0000:                   *
0000:                   * $Id$
0000:                   *
0000:                   * This is how the memory map looks after the kernel has initialized:
0000:                   *
0000:                   *     $0000----> ================================== 
0000:                   *               |                                  |
0000:                   *               |                                  |
0000:                   *  $0020-$0111  |  System Globals (D.FMBM-D.XNMI)  |
0000:                   *               |                                  |
0000:                   *               |                                  |
0000:                   *     $0200---->|==================================|
0000:                   *               |        Free Memory Bitmap        |
0000:                   *  $0200-$021F  |     (1 bit = 256 byte page)      |
0000:                   *               |----------------------------------|
0000:                   *  $0220-$0221  |      IOMan I/O Call Pointer      |
0000:                   *               |----------------------------------|
0000:                   *               |      System Dispatch Table       |
0000:                   *  $0222-$0291  |     (Room for 56 addresses)      |
0000:                   *               |----------------------------------|
0000:                   *  $0292-$02FF  |       User Dispatch Table        |
0000:                   *               |     (Room for 56 addresses)      |
0000:                   *     $0300---->|==================================|
0000:                   *               |                                  |
0000:                   *               |                                  |
0000:                   *  $0300-$03FF  |     Module Directory Entries     |
0000:                   *               |      (Room for 64 entries)       |
0000:                   *               |                                  |
0000:                   *     $0400---->|==================================|
0000:                   *               |                                  |
0000:                   *  $0400-$04FF  |           System Stack           |
0000:                   *               |                                  |
0000:                   *     $0500---->|==================================|
0000:                   *               |                                  |
0000:                   *               |                                  |
0000:                   *               |                                  |
0000:                   *  $0500-$08FF  |    Screen Memory (Atari Only)    |
0000:                   *               |                                  |
0000:                   *               |                                  |
0000:                   *               |                                  |
0000:                   *     $0900---->|==================================|
0000:                   *
0000:                   * Edt/Rev  YYYY/MM/DD  Modified by
0000:                   * Comment
0000:                   * ------------------------------------------------------------------
0000:                   *  14      1985/??/??
0000:                   * From Tandy OS-9 Level One VR 02.00.00
0000:                   *
0000:                   *  15      2002/07/21  Boisy G. Pitre
0000:                   * Module validation consists only of module header parity check.
0000:                   * CRC check is not done unless D.CRC is set to 1, which is NOT the
0000:                   * default case.  By default, D.CRC is set to 0, thus there is no
0000:                   * CRC checking.  Speeds up module loads quite a bit. The Init module
0000:                   * has a bit in a compatibility byte that can turn on/off CRC checking
0000:                   *
0000:                   *  15r1    2003/12/09  Boisy G. Pitre
0000:                   * Kernel no longer scans for modules in I/O space.  Also, F$PrsNam now
0000:                   * allows _ and 0-9 as first chars of a filename.
0000:                   *
0000:                   *  15r1    2004/05/23  Boisy G. Pitre
0000:                   * Renamed to 'krn'
0000:                   *
0000:                   *  16      2004/05/23  Boisy G. Pitre
0000:                   * Added changes for Atari port
0000:                   
0000:                            nam   krn
0000:                            ttl   NitrOS-9 Level 1 Kernel
0000:                   
0000:                            ifp1
0000:                            use   defsfile
0000:                            endc
0000:                   
00C1:                   tylg     set   Systm+Objct
0080:                   atrv     set   ReEnt+rev
0000:                   rev      set   $00
0010:                   edition  set   16
0000:                   
0000: 87CD0811000DC180  ModTop   mod   eom,name,tylg,atrv,OS9Cold,size
0009: 00110000
0000:                   
0000:                   size     equ   .
0000:                   
000D: 4B72EE            name     fcs   /Krn/
0010: 10                         fcb   edition
0011:                   
0011:                   *
0011:                   * OS-9 Genesis!
0011:                   
0011:                   OS9Cold  equ   *
0011:                   * clear out system globals from $0000-$0400
0011:                   *         ldx   #D.FMBM
0011: 8E0000                     ldx   #$0000
0014:                            IFNE  H6309
0014:                   *         ldw   #$400-D.FMBM
0014:                            ldw   #$400
0014:                            leay  Zoro,pc
0014:                            tfm   y,x+
0014:                            ELSE
0014:                   *         ldy   #$400-D.FMBM
0014: 108E0400                   ldy   #$400
0018: 4F                         clra
0019: 5F                         clrb
001A: ED81              L007F    std   ,x++
001C: 313E                       leay  -2,y
001E: 26FA                       bne   L007F
0020:                            ENDC
0020:                   
0020:                   * set up system globals
0020:                            IFNE  H6309
0020:                            ldd   #$200
0020:                            ELSE
0020: 4C                         inca
0021: 4C                         inca                          D = $200
0022:                            ENDC
0022: DD20                       std   <D.FMBM                 $200 = start of free memory bitmap
0024: CB20                       addb  #$20
0026: DD22                       std   <D.FMBM+2               $220 = end of free memory bitmap
0028: CB02                       addb  #$02
002A: DD46                       std   <D.SysDis               $222 = addr of sys dispatch tbl
002C: CB70                       addb  #$70
002E: DD44                       std   <D.UsrDis               $292 = addr of usr dispatch tbl
0030: 5F                         clrb
0031: 4C                         inca                          D = $300
0032: DD26                       std   <D.ModDir               $300 = mod dir start
0034: 9F28                       stx   <D.ModDir+2             X = $400 = mod dir end
0036: 32890100                   leas  >$0100,x                S = $500 (system stack?)
003A:                   
003A:                   * NOTE: This routine checks for RAM by writing a pattern at an address
003A:                   * then reading it back for validation.  On the CoCo, we pretty much know
003A:                   * that we are in all-RAM mode at this point, and the same goes for the
003A:                   * other supported platforms.  So I am taking this code out for the time being.
003A:                   
003A:                            IFNE  CHECK_FOR_VALID_RAM
003A:                   * Check for valid RAM starting at $400
003A: 3184              ChkRAM   leay  ,x
003C: ECA4                       ldd   ,y                      store org contents in D
003E: 8E00FF                     ldx   #$00FF
0041: AFA4                       stx   ,y                      write pattern to ,Y
0043: ACA4                       cmpx  ,y                      same as what we wrote?
0045: 2616                       bne   L00C2                   nope, not RAM here!
0047: 8EFF00                     ldx   #$FF00                  try different pattern
004A: AFA4                       stx   ,y                      write it to ,Y
004C: ACA4                       cmpx  ,y                      same as what we wrote?
004E: 260D                       bne   L00C2                   nope, not RAM here!
0050: EDA4                       std   ,y                      else restore org contents
0052: 30A90100                   leax  >$0100,y                check top of next 256 block
0056: 8CED00                     cmpx  #Bt.Start               stop short of boot track mem
0059: 25DF                       bcs   ChkRAM
005B: 3184                       leay  ,x
005D:                   * Here, Y = end of RAM
005D: 30A4              L00C2    leax  ,y                      X = end of RAM
005F:                            ELSE
005F:                            ldx    #Bt.Start
005F:                            ENDC
005F: 9F24                       stx   <D.MLIM                 save off memory limit
0061:                   
0061:                   * Copy vector code over to address $100
0061: 3410                       pshs  x
0063:                            IFNE  H6309
0063:                            leax  >VectCode,pcr
0063:                            ldy   #D.XSWI3
0063:                            ldw   #VectCSz
0063:                            tfm   x+,y+
0063:                            ELSE
0063: 308D0744                   leax  >VectCode,pcr
0067: 108E0100                   ldy   #D.XSWI3
006B: C629                       ldb   #VectCSz
006D: A680              L00D2    lda   ,x+
006F: A7A0                       sta   ,y+
0071: 5A                         decb
0072: 26F9                       bne   L00D2
0074:                            ENDC
0074: 3510                       puls  x
0076:                   
0076:                   * Atari has bootfile already in memory
0076:                            IFNE  atari
0076:                   * flag that we've booted and that Boot Low starts appropriately
0076:                            ldy   #$D000           Atari: I/O is at $D000-$D7FF
0076:                            inc   <D.Boot
0076:                            stx   <D.BTLO
0076:                            ldx   #$FFFF
0076:                            stx   <D.BTHI
0076:                            ELSE
0076:                            IFNE   corsham
0076:                            ldx    #Bt.Start
0076:                            ldy    #Bt.Start+Bt.Size-1
0076:                            ELSE
0076:                   * CoCo
0076: 108EFD80                   ldy    #Bt.Start+Bt.Size
007A:                            ENDC
007A:                            ENDC
007A:                   
007A: 170715                     lbsr   ValMods
007D:                   
007D:                   * Atari: look for more modules at $D800-$F3FF
007D:                            IFNE  atari
007D:                            ldx   #$D800                           
007D:                            ldy   #$F400
007D:                            lbsr  ValMods
007D:                            ENDC
007D:                            
007D:                   * Copy vectors to system globals
007D: 318D0790          L00EE    leay  >Vectors,pcr
0081: 308DFF7B                   leax  >ModTop,pcr
0085: 3410                       pshs  x
0087: 8E002C                     ldx   #D.SWI3
008A: ECA1              L00FB    ldd   ,y++
008C: E3E4                       addd  ,s
008E: ED81                       std   ,x++
0090: 8C0036                     cmpx  #D.NMI
0093: 23F5                       bls   L00FB
0095: 3262                       leas  2,s                     restore stack
0097:                   
0097:                   * fill in more system globals
0097: 308D0090                   leax  >URtoSs,pcr
009B: 9F84                       stx   <D.URtoSs
009D: 308D0086                   leax  >UsrIRQ,pcr
00A1: 9F3C                       stx   <D.UsrIRQ
00A3: 308D0132                   leax  >UsrSvc,pcr
00A7: 9F40                       stx   <D.UsrSvc
00A9: 308D00A6                   leax  >SysIRQ,pcr
00AD: 9F3E                       stx   <D.SysIRQ
00AF: 9F38                       stx   <D.SvcIRQ
00B1: 308D014C                   leax  >SysSvc,pcr
00B5: 9F42                       stx   <D.SysSvc
00B7: 9F2E                       stx   <D.SWI2
00B9: 308D00A6                   leax  >Poll,pcr          point to default poll routine
00BD: 9F3A                       stx   <D.Poll            and save it 
00BF: 308D00A2                   leax  >Clock,pcr         get default clock routine
00C3: 9F81                       stx   <D.Clock           and save it to the vector
00C5: 9F6B                       stx   <D.AltIRQ          and in the alternate IRQ vector
00C7:                   
00C7:                   * install system calls
00C7: 318D0709                   leay  >SysTbl,pcr
00CB: 1706BD                     lbsr  InstSSvc
00CE:                   
00CE:                   * link to init module
00CE: 86C0                       lda   #Systm+0
00D0: 308D0731                   leax  >InitNam,pcr
00D4: 103F00                     os9   F$Link
00D7: 1025FF36                   lbcs  OS9Cold
00DB: DF2A                       stu   <D.Init
00DD: A6C81B                     lda   Feature1,u               get feature byte 1
00E0: 8501                       bita  #CRCOn                   CRC on?
00E2: 2702                       beq   GetMem                   branch if not (already cleared earlier)
00E4: 0C89                       inc   <D.CRC                   else turn on CRC checking
00E6:                   *GetMem   ldd   MaxMem+1,u              I don't think this exists for Level1 RG
00E6:                   *         clrb
00E6:                   *         cmpd  <D.MLIM                 starts as $EE00
00E6:                   *         bcc   L0158
00E6:                   *         std   <D.MLIM
00E6:                   GetMem   equ   *                        Initially I tried GetMem clra
00E6:                   *                                       that is redundant. See last line. RG
00E6: 9E20              L0158    ldx   <D.FMBM
00E8:                   * Free-memory bitmap. Bit7 of 0,x corresponds to page 0, bit6 to page 1 etc.
00E8:                   * Bit7 of 1,x corresponds to page 8, bit6 to page 9 etc, etc.
00E8:                   
00E8:                            IFNE  atari
00E8:                   * Atari needs $0000-$08FF and $D000-$D7FF reserved
00E8:                            ldb   #%11111111
00E8:                            stb   ,x                       mark $0000-$07FF as allocated
00E8:                            stb   $1A,x                    mark $D000-$D7FF I/O area as allocated
00E8:                            ldb   #%10000000
00E8:                            stb   1,x                      mark $0800-$08FF as allocated
00E8:                            ELSE
00E8:                            IFNE  corsham
00E8:                   * Corsham needs $0000-$04FF and $E000-$EFFF reserved
00E8:                            ldb   #%11111000
00E8:                            stb   ,x                       mark $0000-$04FF as allocated
00E8:                            ldb   #%11111111
00E8:                            stb   $1C,x                    mark $E000-$E7FF I/O area as allocated
00E8:                            stb   $1D,x                    mark $E800-$EFFF I/O area as allocated
00E8:                            ELSE
00E8:                   * CoCo needs $0000-$04FF reserved
00E8: C6F8                       ldb   #%11111000
00EA: E784                       stb   ,x                       mark $0000-$04FF as allocated
00EC:                            ENDC
00EC:                            ENDC
00EC:                   
00EC:                   * For all platforms exclude high memory as defined (earlier) by D.MLIM
00EC: 4F                         clra
00ED: D624                       ldb   <D.MLIM
00EF: 50                         negb
00F0: 1F02                       tfr   d,y
00F2: 50                         negb
00F3: 1704FE                     lbsr  L065A                    in included fallbit.asm
00F6:                   
00F6:                   * jump into krnp2 here
00F6: 308D070F                   leax  >P2Nam,pcr
00FA: 86C1                       lda   #Systm+Objct
00FC: 103F00                     os9   F$Link
00FF: 1025FF0E                   lbcs  OS9Cold
0103: 6EA4                       jmp   ,y
0105:                   
0105: 3494              SWI3     pshs  pc,x,b
0107: C618                       ldb   #P$SWI3
0109: 2013                       bra   L018C
