0583:                   **************************************************
0583:                   * System Call: F$SRqMem
0583:                   *
0583:                   * Function: Request memory
0583:                   *
0583:                   * F$SRqMem allocates memory from the system in 256 byte 'pages.'
0583:                   * There are 256 of these '256 byte pages' in RAM (256*256=64K).
0583:                   * The allocation map, pointed to by D.FMBM holds 8 pages per byte, making the
0583:                   * allocation map itself 32 bytes in size.
0583:                   *
0583:                   * Memory is allocated from the top of the system RAM map downwards.  Rel/Boot/Krn
0583:                   * also reside in this area, and are loaded from $EE00-$FFFF.  Since this area is
0583:                   * always allocated, we start searching for free pages from page $ED downward.
0583:                   *
0583:                   * Input:  D = Byte count
0583:                   *
0583:                   * Output: U = Address of allocated memory area
0583:                   *
0583:                   * Error:  CC = C bit set; B = error code
0583:                   *
0583: EC41              FSRqMem  ldd   R$D,u        get memory allocation size requested
0585: C300FF                     addd  #$00FF       round it up to nearest 256 byte page (e.g. $1FF = $2FE)
0588: 5F                         clrb               just keep # of pages (e.g. $2FE = $200)
0589: ED41                       std   R$D,u        save rounded version back to user
058B: 9E22                       ldx   <D.FMBM+2    get ptr to end of free memory bitmap
058D: CC01FF                     ldd   #$01FF           A = $01 (RAM IN USE flag), B = $FF (counter)
0590: 3406                       pshs  b,a                      save onto stack
0592: 200A                       bra   L0604            start the search
0594: 6A61              L05FA    dec   $01,s
0596: E661                       ldb   $01,s
0598: 68E4              L05FE    lsl   ,s
