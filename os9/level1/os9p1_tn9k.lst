073F:                   **************************************************
073F:                   * System Call: F$CmpNam
073F:                   *
073F:                   * Function: Compare two names
073F:                   *
073F:                   * Input:  X = Address of first name
073F:                   *         Y = Address of second name
073F:                   *         B = length of first name
073F:                   *
073F:                   * Output: None
073F:                   *
073F:                   * Error:  CC = C bit set; B = error code
073F:                   *
073F:                   
073F:                            IFGT  Level-1
073F:                   
073F:                   FCmpNam  ldx   <D.Proc      get current process ptr
073F:                            leay  P$DATImg,x   Point to the DAT image
073F:                            ldx   R$X,u        Get pointer to string #1
073F:                            pshs  y,x          preserve 'em
073F:                            bra   L07CF
073F:                   
073F:                   * F$CmpNam entry point for system state
0583:                   FSCmpNam ldx   <D.Proc      Get current proc. dsc. ptr
073F:                            leay  P$DATImg,x   Point to it's DAT image
073F:                            ldx   R$X,u        get pointer to string #1
073F:                            pshs  x,y
073F:                            ldy   <D.SysDAT    get pointer to system DAT
000F:                   L07CF    ldx   R$Y,u        get pointer to string #2
073F:                            pshs  y,x          Preserve them
073F:                            ldd   R$D,u        get length
073F:                            leax  4,s          point to string #1 info packet
073F:                            leay  ,s           point to string #2 info packet
073F:                            bsr   L07DE        go compare 'em
073F:                            leas  8,s          purge stack
073F:                            rts                return
073F:                   
073F:                   * Compare 2 strings
073F:                   *
073F:                   * Input:  D = Length of string #1 (only requires B)
073F:                   *         X = Ptr to string #1 info packet
073F:                   *             0,X = DAT image pointer
073F:                   *             2,X = Pointer to string
073F:                   *         Y = Ptr to string #2 info packet
073F:                   *             0,Y = DAT image pointer
073F:                   *             2,Y = Pointer to string
073F:                   *         U = Register stack ptr
000F:                   L07DE    pshs  d,x,y,u      preserve registers
073F:                            tfr   x,u          U=ptr to string #1 packet
073F:                            pulu  x,y          get DAT ptr to Y and string ptr to X
073F:                            lbsr  AdjBlk0      adjust X to use block 0
073F:                            pshu  x,y          put them back
073F:                            ldu   4,s          get pointer to string #2 packet
073F:                            pulu  x,y          get DAT ptr to Y and string ptr to X
073F:                            lbsr  AdjBlk0      Adjust X to block 0
073F:                            bra   L07F6        go compare the strings
073F:                   
000F:                   L07F2    ldu   4,s          get pointer to string #2 packet
073F:                            pulu  x,y          get DAT ptr to Y and string ptr to X
000F:                   L07F6    lbsr  LDAXY        Map in the block & grab a byte from string
073F:                            pshu  x,y          Put updated DAT & string ptr back
073F:                            pshs  a            Save the character
073F:                            ldu   3,s          pointer to string #1 packet
073F:                            pulu  x,y          get DAT ptr to Y and string ptr to X
073F:                            lbsr  LDAXY        get byte from string #1
073F:                            pshu  y,x          put pointers back
073F:                            eora  ,s
073F:                            tst   ,s+          was it high bit?
073F:                            bmi   L0816        yes, check if last character in string #2
073F:                            decb  
073F:                            beq   L0813
073F:                            anda  #$DF         match?
073F:                            beq   L07F2        yes, check next character
000F:                   L0813    comb               set carry
073F:                            puls  d,x,y,u,pc
073F:                   
000F:                   L0816    decb               done whole string?
073F:                            bne   L0813        no, exit with no match
073F:                            anda  #$5F         match?
073F:                            bne   L0813        yes, keep checking
073F:                            clrb               strings match, clear carry
073F:                            puls  d,x,y,u,pc   restore & return
073F:                   
073F:                            ELSE
