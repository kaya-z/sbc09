06D9:                   FPrsNam  ldx   <D.Proc          proc desc
06D9:                            leay  <P$DATImg,x      Y=DAT image ptr
06D9:                            ldx   R$X,u            X=name string
06D9:                            bsr   ParseNam         get it and length
06D9:                            std   R$D,u            return length in D
06D9:                            bcs   L073E            ..err
06D9:                            stx   R$X,u            and X at name begin
06D9:                            abx                    plus len
0000:                   L073E    stx   R$Y,u            return Y=end of name ptr
06D9:                            rts                    end.
06D9:                   
06D9:                   * Parse name
06E7:                   ParseNam equ   *
06D9:                            pshs  y                save DAT image pointer
06D9:                            lbsr  AdjBlk0          go find map block...
06D9:                            pshs  x,y              save X offset within block and Y block pointer
06D9:                            bsr   GoGetAXY         go get byte at X in block Y...
06D9:                            cmpa  #'.              is the first character a period?
06D9:                            bne   IsSlash          no, do proper first character checking
06D9:                            lbsr  L0AC8            do a LDAXY, without changing X or Y
06D9:                            bsr   ChkFirst         is the next character non-period?
06D9:                            lda   #'.              restore the period character the LDAXY destroyed
06D9:                            bcc   Do.Loop          if NON-period character, skip 1st char checks
06D9:                   
0017:                   IsSlash  cmpa  #PDELIM          is it a slash?
06D9:                            bne   NotSlash         no, go keep X offset and block Y...
06D9:                            bsr   GetChar          go get character...
0010:                   NotSlash bsr   ChkFirst         go check if valid first character...
06D9:                            bcs   NotValid         not valid, go get next name start offset in X...
034F:                   Do.Loop  clrb                   initialize character counter
003F:                   LastLoop incb                   add one character
06D9:                            tsta                   last character in name string?
06D9:                            bmi   LastChar         yes, go return valid...
06D9:                            bsr   GoGetAXY         go get next character...
06D9:                            bsr   ChkValid         go check if valid character...
06D9:                            bcc   LastLoop         valid, go check if last character...
003F:                   LastChar andcc #^Carry
06D9:                            bra   RtnValid
06D9:                   
00E6:                   GetChar
06D9:                            stx   2,s          save current offset over old offset
06D9:                            sty   4,s          save current block pointer over old block pointer
0000:                   GoGetAXY lbra  LDAXY        go get byte at X in block Y in A,  & return
06D9:                   
0000:                   NextLoop bsr   GetChar      go get character...
0010:                   NotValid cmpa  #',          comma?
06D9:                            beq   NextLoop     yes, go get next character...
06D9:                            cmpa  #C$SPAC      space?
06D9:                            beq   NextLoop     yes, go get next character...
06D9:                            comb               error, set Carry
06D9:                            ldb   #E$BNam      'Bad Name' error
0002:                   RtnValid equ   *
06D9:                            puls  x,y          recover offset & pointer
06D9:                            bra   L0720        go do a similar exit routine
06D9:                   
071C:                   ChkFirst pshs  a            save character
06D9:                            anda  #$7F         drop msbit
06D9:                            bra   ChkRst       skip dash for first character check
06D9:                   
06D9:                   * Determine if character in A is a valid filename character
0165:                   ChkValid pshs  a            save character
06D9:                            anda  #$7F         drop msbit
06D9:                            cmpa  #'.          period?
06D9:                            beq   ValidChr     yes, go return valid character...
0720:                   ChkRest  cmpa  #'-          is it a dash?
06D9:                            beq   ValidChr     yes, it's valid      
0165:                   ChkRst   cmpa  #'z          greater than "z"?
06D9:                            bhi   InvalidC     yes, go return invalid character...
06D9:                            cmpa  #'a          greater than or equal to "a"?
06D9:                            bhs   ValidChr     yes, go return valid character...
06D9:                            cmpa  #'_          underscore?
06D9:                            beq   ValidChr     yes, go return valid character...
06D9:                            cmpa  #'Z          greater than "Z"?
06D9:                            bhi   InvalidC     yes, go return invalid character...
06D9:                            cmpa  #'A          greater than or equal to "A"?
06D9:                            bhs   ValidChr     yes, go return valid character...
06D9:                            cmpa  #'9          greater than "9"?
06D9:                            bhi   InvalidC     yes, go return invalid character...
06D9:                            cmpa  #'0          greater than or equal to "0"?
06D9:                            bhs   ValidChr     yes, go return valid character...
06D9:                            cmpa  #'$          dollar symbol?
06D9:                            beq   ValidChr     yes, go return valid character...
007F:                   InvalidC coma               invalid character, set carry
032F:                   ValidChr puls  a,pc
