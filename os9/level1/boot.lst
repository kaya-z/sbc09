0000:                   ********************************************************************
0000:                   * Boot - disk booter of the sim09 / sbc09 "v09" machine (Level 1)
0000:                   *
0000:                   * SPDX-License-Identifier: MIT
0000:                   * Copyright (c) 2026 sim09 contributors
0000:                   *
0000:                   * Reads the boot file (OS9Boot) of drive 0 through the DMA disk port at
0000:                   * $E040 (the one the PDisk driver uses; on the FPGA it is the SD card)
0000:                   * and hands it to the kernel.  The reading of LSN 0 and of the boot file
0000:                   * is done by boot_common.asm (NitrOS-9, used unchanged): this file only
0000:                   * provides HWInit, HWTerm and HWRead.
0000:                   *
0000:                   * The port:  +0 command ($81 = read a sector) / result (0 = ok)
0000:                   *            +1 drive   +2..+4 LSN (24 bits)   +5,+6 address of the buffer
0000:                   
0000:                            nam   Boot
0000:                            ttl   Boot from the v09 disk port
0000:                   
0000:                            ifp1
0000:                            use   defsfile
0000:                            endc
0000:                   
00C1:                   tylg     set   Systm+Objct
0080:                   atrv     set   ReEnt+rev
0000:                   rev      set   $00
0001:                   edition  set   1
0000:                   
0000: 87CD00C5000DC180           mod   eom,name,tylg,atrv,start,size
0009: 0035000A
0000:                   
0000:                   * NOTE: these are U-stack offsets (boot_common.asm uses them)
0000:                   seglist  rmb   2                pointer to segment list
0002:                   blockloc rmb   2                pointer to memory requested
0004:                   blockimg rmb   2                duplicate of the above
0006:                   bootsize rmb   2                size in bytes
0008:                   LSN0Ptr  rmb   2                in memory LSN0 pointer
000A:                   size     equ   .
000A:                   
000D: 426F6FF4          name     fcs   /Boot/
0011: 01                         fcb   edition
0012:                   
0001:                   LSN24BIT equ   1
0000:                   FLOPPY   equ   0
0012:                   
0012:                   * HWInit - nothing to do (the disk port is always ready)
0012:                   *   Entry: Y = hardware address
0012:                   *   Exit:  Carry Clear = OK
0012: 5F                HWInit   clrb
0013: 39                         rts
0014:                   
0014:                   * HWTerm
0014: 5F                HWTerm   clrb
0015: 39                         rts
0016:                   
0016:                   * HWRead - read a 256 byte sector
0016:                   *   Entry: Y = hardware address
0016:                   *          B = bits 23-16 of LSN
0016:                   *          X = bits 15-0  of LSN
0016:                   *          blockloc,u = ptr to 256 byte sector
0016:                   *   Exit:  X = ptr to data (i.e. ptr in blockloc,u)
0016:                   *          Carry Clear = OK, Set = Error (B = error)
0016: E722              HWRead   stb   2,y              LSN, bits 23-16
0018: 1F10                       tfr   x,d
001A: A723                       sta   3,y
001C: E724                       stb   4,y
001E: 6F21                       clr   1,y              drive 0
0020: EC42                       ldd   blockloc,u
0022: A725                       sta   5,y              address of the buffer
0024: E726                       stb   6,y
0026: 8681                       lda   #$81
0028: A7A4                       sta   ,y               read (the CPU waits for the transfer)
002A: E6A4                       ldb   ,y               result
002C: 2604                       bne   HWRErr
002E: AE42                       ldx   blockloc,u
0030: 5F                         clrb
0031: 39                         rts
0032: 1A01              HWRErr   orcc  #1
0034: 39                         rts
0035:                   
0035:                   ********************************************************************
0035:                   * Boot Common - Common code for NitrOS-9 booters
0035:                   *
0035:                   * $Id$
0035:                   *
0035:                   * This common file is not a stand-alone module, but is 'used' by boot module
0035:                   * source files to bring in support for booting from RBF file systems that have
0035:                   * either standard or new-style fragmented bootfiles.
0035:                   *
0035:                   * This code uses several static variables which are expected to be defined in
0035:                   * the main boot source code.  See a booter like boot_1773.asm for an example on
0035:                   * how to write a booter which uses this code.
0035:                   *
0035:                   * Important Notes:
0035:                   * For certain devices, only the lower 16 bits of DD.BT are used.  This special
0035:                   * case allows us to save some code by ignoring the loading LSN bits 23-16 in
0035:                   * DD.BT and FDSL.A.  Booters for such devices (floppy, RAMPak) should have the
0035:                   * following line in their code to take advantage of this optimization:
0035:                   *
0035:                   * LSN24BIT equ 0
0035:                   *
0035:                   * Floppy booters require the acquistion of DD.TKS and DD.FMT from LSN0 to make
0035:                   * certain decisions about the boot process.  In most cases, non-floppy booters
0035:                   * do not need these values.  Hence, floppy booters should have this line in their
0035:                   * source code file:
0035:                   *
0035:                   * FLOPPY equ 1
0035:                   *
0035:                   * Edt/Rev  YYYY/MM/DD  Modified by
0035:                   * Comment
0035:                   * ------------------------------------------------------------------
0035:                   *          2005/10/14  Boisy G. Pitre
0035:                   * Created as a stand-alone file.
0035:                   *
0035:                   *          2005/10/16  Boisy G. Pitre
0035:                   * Further optimizations made
0035:                   *
0035:                   *          2006/01/04  P.Harvey-Smith.
0035:                   * Added pointer to loaded LSN0 to data passed to hardware dependent section.
0035:                   *
0035:                   *          2007/08/23  Boisy G. Pitre
0035:                   * Added 'subd #$00FF' to counteract earlier 'addd #$00FF'.  We need to undo
0035:                   * to give F$SRqMem the right amount of memory to allocate.
0035:                   *
0035:                   *          2007/08/24  Boisy G. Pitre
0035:                   * We no longer use F$SRqMem to get the 256 byte buffer for LSN0, but
0035:                   * instead allocate the memory temporarily off the stack.  This gives us
0035:                   * two system ram pages that were not available before, and also prevents
0035:                   * a needless system call.
0035:                   * Note: For Level 1, we actually use the page above the stack at $500-$5FF
0035:                   * to hold LSN0 during the bootfile acquisition process. This is because the
0035:                   * system stack is only 256 bytes and we are using more than that.  Since
0035:                   * the module directory table is at $400-$4FF, we must do this; otherwise, we
0035:                   * would overwrite the bottom portion of the module directory table and corrupt
0035:                   * it (it's already setup by krn before boot is called!)
0035:                   
0035: 1A50              start    orcc  #IntMasks  ensure IRQs are off (necessary?)
0037:                   * allocate memory on stack for vars and sector buffer
0037:                          IFEQ  Level-1
0037:                   * Level 1: stack is only 256 bytes and its bottom runs against moddir ptrs..
0037:                   * so cheat and use free page just above stack as 256-byte disk buffer
0037: 3276                       leas  -size,s
0039: 1F43                       tfr   s,u        get pointer to data area
003B: 8E0500                     ldx   #$500
003E:                          ELSE
003E:                            leas  -size-256,s
003E:                            tfr   s,u        get pointer to data area
003E:                            leax  size,u     point U to 256 byte sector buffer
003E:                          ENDC
003E: 3440                       pshs  u          save pointer to data area
0040: AF42                       stx   blockloc,u
0042:                   
0042:                   * Initialize Hardware
0042: 10AE8D0079                 ldy   Address,pcr  get hardware address
0047: 17FFC8                     lbsr  HWInit
004A:                   
004A:                   * Read LSN0
004A:                          IFNE  LSN24BIT
004A: 5F                         clrb             MSB sector
004B:                          ENDC
004B: 8E0000                     ldx   #0         LSW sector
004E: 17FFC5                     lbsr  HWRead     read LSN 0
0051: 2524                       bcs   error      branch if error
0053:                   
0053:                          IFGT  Level-1
0053:                            lda   #'0        --- loaded in LSN0'
0053:                            jsr   <D.BtBug   ---
0053:                          ENDC
0053:                   
0053: AF48                       stx   LSN0Ptr,u    Save LSN0 pointer
0055:                   * Pull relevant values from LSN0
0055:                          IFNE  FLOPPY
0055:                            lda   DD.TKS,x   number of tracks on this disk
0055:                            ldb   DD.FMT,x   disk format byte
0055:                            std   ddtks,u    TAKE NOTE!  ASSUMES ADJACENT VARS!
0055:                          ENDC
0055: EC8818                     ldd   DD.BSZ,x   os9boot size in bytes
0058: 2720                       beq   FragBoot   if zero, do frag boot
005A: ED46                       std   bootsize,u
005C:                   * Old style boot -- make a fake FD segment right from LSN0!
005C: 308815                     leax  DD.BT,x
005F: C300FF                     addd  #$00FF     round up to next page
0062:                   * Important note: We are making an assumption that the upper 8 bits of the
0062:                   * FDSL.B field will always be zero.  That is a safe assumption, since an
0062:                   * FDSL.B value of $00FF would mean the file is 65280 bytes.  A bootfile
0062:                   * under NitrOS-9 cannot be this large, and therefore this assumption
0062:                   * is safe.
0062: A704                       sta   FDSL.B+1,x save file size
0064:                          IFNE  LSN24BIT
0064: 6F05                       clr   FDSL.S,x   make next segment entry 0
0066:                          ENDC
0066: 6F06                       clr   FDSL.S+1,x
0068: 6F07                       clr   FDSL.S+2,x
006A: 8300FF                     subd  #$00FF     undo previous add #$00FF
006D: 201B                       bra   GrabBootMem
006F:                   
006F: 17FFA2            Back2Krn lbsr  HWTerm     call HW termination routine
0072: AE44                       ldx   blockimg,u pointer to start of os9boot in memory
0074: 5F                         clrb             clear carry
0075: EC46                       ldd   bootsize,u
0077:                   error
0077:                          IFEQ  Level-1
0077: 326C                       leas  2+size,s      reset the stack    same as PULS U
0079:                          ELSE
0079:                            leas  2+size+256,s  reset the stack    same as PULS U
0079:                          ENDC
0079: 39                         rts              return to kernel
007A:                   
007A:                   
007A:                   * NEW! Fragmented boot support!
007A:                   *FragBoot ldb   bootloc,u  MSB fd sector location
007A:                   *         ldx   bootloc+1,u LSW fd sector location
007A: E68815            FragBoot ldb   DD.BT,x    MSB fd sector location
007D: AE8816                     ldx   DD.BT+1,x  LSW fd sector location
0080: 17FF93                     lbsr  HWRead     get fd sector
0083: EC0B                       ldd   FD.SIZ+2,x get file size (we skip first two bytes)
0085: ED46                       std   bootsize,u
0087: 308810                     leax  FD.SEG,x   point to segment table
008A:                   
008A:                   GrabBootMem
008A:                          IFGT  Level-1
008A:                            os9   F$BtMem
008A:                          ELSE
008A: 103F28                     os9   F$SRqMem
008D:                          ENDC
008D: 25E8                       bcs   error
008F:                   * Save off alloced mem from F$SRqMem into blockloc,u and restore
008F:                   * the statics pointer in U
008F: 1F30                       tfr   u,d        save pointer to requested memory
0091: EEE4                       ldu   ,s         recover pointer to data stack
0093: ED42                       std   blockloc,u
0095: ED44                       std   blockimg,u
0097:                   
0097:                   * Get os9boot into memory
0097: AF40              BootLoop stx   seglist,u  update segment list
0099:                          IFNE  LSN24BIT
0099: E600                       ldb   FDSL.A,x   MSB sector location
009B:                          ENDC
009B: AE01              BL2      ldx   FDSL.A+1,x LSW sector location
009D:                          IFNE  LSN24BIT
009D: 2603                       bne   BL3
009F: 5D                         tstb
00A0:                          ENDC
00A0: 27CD                       beq   Back2Krn
00A2: 17FF71            BL3      lbsr  HWRead
00A5: 6C42                       inc   blockloc,u point to next input sector in mem
00A7:                   
00A7:                          IFGT  Level-1
00A7:                            lda   #'.        show .'
00A7:                            jsr   <D.BtBug
00A7:                          ENDC
00A7:                   
00A7: AE40                       ldx   seglist,u  get pointer to segment list
00A9: 6A04                       dec   FDSL.B+1,x get segment size
00AB: 270F                       beq   NextSeg    if <=0, get next segment
00AD:                   
00AD: EC01                       ldd   FDSL.A+1,x update sector location by one
00AF: C30001                     addd  #1
00B2: ED01                       std   FDSL.A+1,x
00B4:                          IFNE  LSN24BIT
00B4: E600                       ldb   FDSL.A,x
00B6: C900                       adcb  #0
00B8: E700                       stb   FDSL.A,x
00BA:                          ENDC
00BA: 20DF                       bra   BL2
00BC:                   
00BC: 3005              NextSeg  leax  FDSL.S,x   advance to next segment entry
00BE: 20D7                       bra   BootLoop
00BE:                   
00C0:                   
00C0: E040              Address  fdb   $E040
00C2: F8B16A                     emod
00C5:                   eom      equ   *
