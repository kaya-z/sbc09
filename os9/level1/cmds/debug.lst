09A9:                   * 6551 Parameters
0004:                   ADDR     equ   $FF68     
09A9:                   
0000:                   A_RXD    equ   ADDR+$00
0000:                   A_TXD    equ   ADDR+$00
0000:                   A_STATUS equ   ADDR+$01
0000:                   A_RESET  equ   ADDR+$01
0000:                   A_CMD    equ   ADDR+$02
0000:                   A_CTRL   equ   ADDR+$03
09A9:                                            
09A9:                   * Baud rates
09A9:                   _B2400    equ   $1A      2400 bps, 8-N-1
09A9:                   _B4800    equ   $1C      4800 bps, 8-N-1
09A9:                   _B9600    equ   $1E      9600 bps, 8-N-1
09A9:                   _B19200   equ   $1F      19200 bps, 8-N-1
09A9:                   
0934:                   BAUD     equ   _B9600
09A9:                   
09A9:                   * Init - Initialize
09A9:                   * Exit: Carry = 0: Init success; Carry = 1; Init failed
000E:                   Init                     
09A9:                            sta   A_RESET    soft reset (value not important)
09A9:                   * Set specific modes and functions:
09A9:                   * - no parity, no echo, no Tx interrupt
09A9:                   * no Rx interrupt, enable Tx/Rx
09A9:                            lda   #$0B
09A9:                            sta   A_CMD      save to command register
09A9:                            lda   #BAUD
09A9:                            sta   A_CTRL     select proper baud rate
09A9:                   * Read any junk rx byte that may be in the register
09A9:                            lda   A_RXD
09A9:                            rts             
09A9:                                            
09A9:                   * Read - Read one character
09A9:                   * Exit:  A = character that was read
0001:                   Read                     
0040:                   r@       lda   A_STATUS   get status byte
09A9:                            anda  #$08       mask rx buffer status flag
09A9:                            beq   r@         loop if rx buffer empty
09A9:                            lda   A_RXD      get byte from ACIA data port
09A9:                            rts             
09A9:                                            
09A9:                   * Write - Write one character
09A9:                   * Entry: A = character to write
0002:                   Write                    
09A9:                            pshs  a          save byte to write
063C:                   w@       lda   A_STATUS   get status byte
09A9:                            anda  #$10       mask tx buffer status flag
09A9:                            beq   w@         loop if tx buffer full
09A9:                            puls  a          get byte
09A9:                            sta   A_TXD      save to ACIA data port
09A9:                            rts             
09A9:                                            
09A9:                   * Term - Terminate
0020:                   Term                     
09A9:                            rts             
09A9:                                            
09A9:                   
09A9:                   * llwout - Write an entire string
09A9:                   * llwerr - Write an entire string
0991:                   llwerr
0994:                   llwout
09A9:                            pshs  a
019C:                   l@       lda   ,x+
09A9:                            cmpa  #C$CR
09A9:                            beq   e@
09A9:                            leay  -1,y
09A9:                            beq   f@
09A9:                            bsr   Write
09A9:                            bra   l@
0135:                   e@       bsr   Write
09A9:                            lda   #C$LF
09A9:                            bsr   Write
0000:                   f@       ldx   <buffptr
09A9:                            clrb
09A9:                            puls  a,pc
09A9:                   
09A9:                   * ReadLine - Read an entire string, up to CR
09A9:                   * Entry: X = address to place string being read (CR terminated)
09A9:                   *        Y = maximum number of bytes to read (including nul byte)
099C:                   ReadLine
09A9:                            ldx   <buffptr
09A9:                            pshs  y,x,a
09A9:                            ldy   #80
019C:                   l@       bsr   Read         read 1 character
09A9:                            cmpa  #C$CR        carriage return?
09A9:                            beq   e@           branch if so...
09A9:                            cmpa  #$08         backspace?
09A9:                            beq   bs@           
09A9:                            cmpy  #$0000       anymore room?
09A9:                            beq   l@
09A9:                            leay  -1,y         back up one char
09A9:                            sta   ,x+          and save in input buffer
FF7F:                   m@       bsr   Write        echo back out
09A9:                            bra   l@
0135:                   e@       sta   ,x
09A9:                            bsr   Write
09A9:                            lda   #C$LF
09A9:                            bsr   Write
09A9:                            clrb
09A9:                            puls  a,x,y,pc
EE00:                   bs@      cmpx  1,s          are we at start
09A9:                            beq   l@           if so, do nothing
09A9:                            clr   ,-x          else erase last byte
09A9:                            lbsr  Write        write backspace
09A9:                            lda   #C$SPAC      a space...
09A9:                            lbsr  Write        write it
09A9:                            leay  1,y          count back up free char
09A9:                            lda   #$08         another backspace
09A9:                            bra   m@
09A9:                   
09A9:                            ENDC
09A9:                    
09A9: DA29F3                     emod
09AC:                   eom      equ   *
09AC:                            end
