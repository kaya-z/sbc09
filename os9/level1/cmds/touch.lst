0000:                   * ------------------------------------------------------------------
0000:                   *   2      2003/01/11  Boisy G. Pitre
0000:                   * Rewrote touch from scratch, made almost 90% smaller than C version
0000:                   * found in the OS-9 Development System.
0000:                   
0000:                            nam   Touch
0000:                            ttl   Changes last modification date/time
0000:                   
0000:                            ifp1
0000:                            use   defsfile
0000:                            endc
0000:                   
0000:                   * Here are some tweakable options
0000:                   DOHELP   set   0        1 = include help info
0080:                   STACKSZ  set   128      estimated stack size
0100:                   PARMSZ   set   256      estimated parameter size
0040:                   ZOPTSIZ  set   64       max size of -z option's parameter
0000:                   
0000:                   * Module header definitions
0011:                   tylg     set   Prgrm+Objct   
0080:                   atrv     set   ReEnt+rev
0000:                   rev      set   $00
0002:                   edition  set   2
0000:                   
0000: 87CD0233000D1180           mod   eom,name,tylg,atrv,start,size
0009: 003403CC
0000:                   
0000:                   * Your utility's static storage vars go here
0000:                            org   0
0000:                   parmptr  rmb   2        pointer to our command line params
0002:                   bufptr   rmb   2        pointer to user expandable buffer
0004:                   bufsiz   rmb   2        size of user expandable buffer
0006:                   * What follows are utility specific options
0006:                   nocreate rmb   1
0007:                   quiterr  rmb   1
0008:                   filemode rmb   1
0009:                   filecnt  rmb   1
000A:                   zoptflg  rmb   1        1 = this option has been processed once already
000B:                   zpath    rmb   1        path to -z file
000C:                   cleartop equ   .        everything up to here gets cleared at start
000C:                   zopt     rmb   ZOPTSIZ  buffer for what follows after -c=
004C:                   * Next is a user adjustable buffer with # modifier on command line.
004C:                   * Some utilities won't need this, some will.
004C:                   * Currently set up to be larger for Level 2 than Level 1
004C:                   * Note: this buffer must come just before the stack
004C:                            IFGT  Level-1
004C:                   bigbuff  rmb   8*1024           8K default buffer for Level 2
004C:                            ELSE
004C:                   bigbuff  rmb   512              512 byte default buffer for Level 1
024C:                            ENDC
024C:                   * Finally the stack for any PSHS/PULS/BSR/LBSRs that we might do
024C:                            rmb   STACKSZ+PARMSZ
03CC:                   size     equ   .
03CC:                   
03CC:                   * The utility name and edition goes here
000D: 546F7563E8        name     fcs   /Touch/
0012: 02                         fcb   edition
0013:                   
0013:                   * Place constant strings here
0013:                            IFNE  DOHELP
00FF:                   HlpMsg   fcb   C$LF
0013:                            fcc   /Use: Touch [<opts>] <path> [<path>] [<opts>]/
0013:                            fcb   C$LF
0013:                            fcc   /  -c = don't create files/
0013:                            fcb   C$LF
0013:                            fcc   /  -q = don't quit on error/
0013:                            fcb   C$LF
0013:                            fcc   /  -x = search execution directory/
0013:                            fcb   C$LF
0013:                            fcc   /  -z = get files from standard input/
0013:                            fcb   C$LF
0013:                            fcc   /  -z=<file> get files from <file>/
0013:                            fcb   C$LF
0080:                   CR       fcb   C$CR
00FF:                   HlpMsgL  equ   *-HlpMsg
0013:                            ENDC
