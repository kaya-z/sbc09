0106:                   L0125    equ   *
0106:                          IFEQ  atari+corsham
0106:                          IFEQ  Level-1
0106:                   * Setup BASIC code (CoCo port only)
0106:                   *         leax  >BasicRst,pcr
0106:                   *         ldu   #D.CBStrt
0106:                   *         ldb   #BasicRL
0106:                   *CopyLoop lda   ,x+
0106:                   *         sta   ,u+
0106:                   *         decb
0106:                   *         bne   CopyLoop
0106:                          ELSE
0106:                            os9   F$ID                    get process ID
0106:                            lbcs  L01A9                   fail
0106:                            leax  ,u
0106:                            os9   F$GPrDsc                get process descriptor copy
0106:                            lbcs  L01A9                   fail
0106:                            leay  ,u
0106:                            ldx   #$0000
0106:                            ldb   #$01
0106:                            os9   F$MapBlk
0106:                            bcs   L01A9
0106:                   
0106:                   *         lda   #$55                    set flag for Color BASIC
0106:                   *         sta   <D.CBStrt,u
0106:                   * Copy our default I/O ptrs to the system process
0106:                            ldd   <D.SysPrc,u
0106:                            leau  d,u
0106:                            leau  <P$DIO,u
0106:                            leay  <P$DIO,y
0106:                            ldb   #DefIOSiz-1
000F:                   L0151    lda   b,y
0106:                            sta   b,u
0106:                            decb
0106:                            bpl   L0151
0106:                          ENDC
0106:                          ENDC
0106:                   *
0106:                   *       IFEQ  ROM
0106:                   * Fork shell startup here
0106:                   *       IFEQ  atari+corsham
0106:                   * Added 12/14/03: If SHIFT is held down, startup is not run (CoCo only)
0106:                   *         lda   #$01                    standard output
0106:                   *         ldb   #SS.KySns
0106:                   *         os9   I$GetStt
0106:                   *         bcs   DoStartup
0106:                   *         bita  #SHIFTBIT               SHIFT key down?
0106:                   *         bne   L0186                   Yes, don't to startup or autoex
0106:                   *        ENDC
0106:                   
0106:                   *DoStartup leax  >Shell,pcr
0106:                   *         leau  >Startup,pcr
0106:                   *         ldd   #256
0106:                   *         ldy   #StartupL
0106:                   *         os9   F$Fork
0106:                   *         bcs   DoAuto                  Startup failed..
0106:                   *         os9   F$Wait
0106:                   *       ENDC
0106:                   
0106:                   * Fork AutoEx here
0106:                   *DoAuto   leax  >AutoEx,pcr
0106:                   *         leau  >CRtn,pcr
0106:                   *         ldd   #$0100
0106:                   *         ldy   #$0001
0106:                   *         os9   F$Fork
0106:                   *         bcs   L0186                   AutoEx failed..
0106:                   *         os9   F$Wait
0106:                   
0106:                   L0186    equ   *
0106: EEE4                       ldu    ,s
0108: 308DFF6A          FrkShell leax  >ShellPrm,pcr
010C: 31C4                       leay  ,u
010E: C601                       ldb   #ShellPL
0110: A680              L0190    lda   ,x+
0112: A7A0                       sta   ,y+
0114: 5A                         decb
0115: 26F9                       bne   L0190
0117:                   * Fork final shell here
0117: 308DFF42                   leax  >Shell,pcr
011B: 8601                       lda   #$01                    D = 256 (B already 0 from above)
011D: 108E0001                   ldy   #ShellPL
0121:                          IFGT  Level-1
0121:                            os9   F$Chain                 Level 2/3. Should not return..
0121:                            ldb   #$06                    it did! Fatal. Load error code
0121:                            bra   Crash
0121:                   
000F:                   L01A9    ldb   #$04                    error code
0080:                   Crash    clr   >DPort+$08              turn off disk motor
0121:                            jmp   <D.Crash                fatal error
0121:                          ELSE
0121: 103F03                     os9   F$Fork                  Level 1.
0124: 2505                       bcs   DeadEnd                 Fatal.
0126: 103F04                     os9   F$Wait
0129: 24DD                       bcc   FrkShell                OK, go start shell.
012B: 20FE              DeadEnd  bra   DeadEnd
