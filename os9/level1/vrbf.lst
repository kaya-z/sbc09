004F: C6D2                       ldb   #$d2
0051: E784                       stb   ,x
0053: E684                       ldb   ,x
0055: C100                       cmpb  #0
0057: 2733                       beq   ok00
0059: 2024                       bra   er00
005B:                   
005B:                   *        u    user stack
005B:                   *        y    path descriptor
005B:                   *         PD.PD.y     path number
005B:                   *         PD.PD.MOD.y mode
005B:                   *         PD.RGS,y    caller's rega  = u
005B:                   *         PD.DEV,y    device table
005B:                   *         PD.DRV,y    drive number
005B:                   
005B: AE23              setuppd  ldx   PD.DEV,y         get device table
005D: AE04                       ldx   4,x              get device module
005F: AE0F                       ldx   $f,x            get port address
0061: 10AF07                     sty   7,x              path descriptor
0064: EF05                       stu   5,x              caller stack
0066: A6A821                     lda   <PD.DRV,y
0069: A701                       sta   1,x
006B: 109E4B                     ldy   <D.Proc          get process pointer
006E: A641                       lda   R$A,u
0070: 8504                       bita  #EXEC.
0072: 2605                       bne   usechx
0074: E6A81D                     ldb   P$DIO+3,y        get curwdir #pdnumber
0077: 2003                       bra   s1
0079: E6A823            usechx   ldb   P$DIO+9,y        get curxdir #pdnumber
007C: E704              s1       stb   4,x
