0039:                   *
0039:                   * I$Create Entry Point
0039:                   *
0039:                   * Entry: A = access mode desired (0 read, 1 write, 2 update, bit 4 for exex)
0039:                   *        B = file attributes
0039:                   *        X = address of the pathlist
0039:                   *
0039:                   * Exit:  A = pathnum
0039:                   *        X = last byte of pathlist address
0039:                   *
0039:                   * Error: CC Carry set
0039:                   *        B = errcode
0039:                   *
0039: 3461              Create   pshs  y,u,cc           Preserve path desc ptr
003B: 1A50                       orcc  #IntMasks
003D: 8D1C                       bsr   setuppd
003F: C6D1                       ldb   #$d1
0041: E784                       stb   ,x               do IO   b,x will be rewrited
0043: E684                       ldb   ,x
0045: 2745                       beq   ok00
0047: 2036                       bra   er00
