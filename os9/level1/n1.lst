0000:                   ****************************************
0000:                   * Network port descriptors N1 N2 N3 (OS-9 Net)
0000:                   *
0000:                   * Assemble with  -D P1 | -D P2 | -D P3   (port number)
0000:                   *                -D L2                    (Level 2 I/O base $FF80, Level 1: $E000)
0000:                   * and optionally -D EUC / -D SJIS         (terminal character set, default UTF-8)
0000:                   ****************************************
0000:                            ifp1
0000:                            use defsfile
0000:                            endc
0000:                   
0000:                            nam N1
0000:                            ttl Network port device descriptor
0000:                   
0001:                   KMODE    set   1
0000:                            IFNE  EUC
0001:                   KMODE    set   2
0000:                            ENDC
0000:                            IFNE  SJIS
0001:                   KMODE    set   3
0000:                            ENDC
0000:                   
E004:                   IOBASE   set   $E004
0000:                            IFNE  L2
E004:                   IOBASE   set   $FF84
0000:                            ENDC
0000:                            IFNE  P2
E004:                   IOBASE   set   IOBASE+2
0000:                            ENDC
0000:                            IFNE  P3
E004:                   IOBASE   set   IOBASE+4
0000:                            ENDC
0000:                   
0004:                   EOFCH    set   $04
0012:                   RPRCH    set   $12
0000:                            IFNE  L2
0004:                   EOFCH    set   $1b
0012:                   RPRCH    set   $04
0000:                            ENDC
0000:                   
