001C: 18                         fcb $18 delete line char
001D: 0D                         fcb $0D end of record
001E: 04                         fcb EOFCH eof
001F: 12                         fcb RPRCH reprint line char
0020: 01                         fcb $01 duplicate last line char
0021: 17                         fcb $17 pause char
0022: 03                         fcb $03 interrupt char
0023: 05                         fcb $05 quit char
0024: 08                         fcb $08 backspace echo char
0025: 07                         fcb $07 bell
0026: 01                         fcb KMODE PD.PAR terminal encoding 1=UTF-8 2=EUC-JP 3=SJIS
0027: 00                         fcb $00 n/a
