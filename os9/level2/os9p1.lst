00B2: 4C                        inca                    D = $0100
00B3:                         ENDC
00B3:                   
00B3:                   * Set up system variables in DP
00B3: DD20                      std     <D.Tasks        set Task Structure pointer to $0100
00B5: CB20                      addb    #$20
00B7: DDA1                      std     <D.TskIPt       set Task image table pointer to $0120
00B9: 5F                        clrb
00BA:                   
00BA:                   ********************************************************************
00BA:                   * The memory block map is a data structure that is used to manage
00BA:                   * physical memory. Physical memory is assigned in 8Kbyte "blocks".
00BA:                   * 256 bytes are reserved for the map and so the maximum physical
00BA:                   * memory size is 256*8Kbyte=2Mbyte. D.BlkMap is a pointer to the
00BA:                   * start of the map (set to $0200, below). D.BlkMap+2 is a pointer
00BA:                   * to the end of the map. Rather than simply setting it to $0300,
00BA:                   * the end pointer is set by the memory sizing routine at L0111.
00BA:                   * (Presumably) this makes it faster to search for unused pages
00BA:                   * and also acts as the mechanism to avoid assigning non-existent
00BA:                   * memory. A value of 0 indicates an unused block and since the
00BA:                   * system block has been initialised to 0 (above) every block starts
00BA:                   * off marked as unused. Initial reservation of blocks occurs
00BA:                   * below, after the memory sizing.
00BA:                   * See "Level 2 flags" in os9.d for other byte values.
00BA:                   
00BA: 4C                        inca
00BB: DD40                      std     <D.BlkMap
00BD: CB40                      addb    #$40            set second block map pointer to $0240
00BF: DD42                      std     <D.BlkMap+2
00C1: 5F                        clrb                    set system service dispatch table pointer
00C2: 4C                        inca                    to 0x300
00C3: DDC2                      std     <D.SysDis
00C5: 4C                        inca                    set user dispatch table pointer to $0400
00C6: DDC8                      std     <D.UsrDis
00C8: 4C                        inca                    set process descriptor block pointer to $0500
00C9: DD48                      std     <D.PrcDBT
00CB: 4C                        inca                    set system process descriptor pointer to $0600
00CC: DD4A                      std     <D.SysPrc
00CE: DD50                      std     <D.Proc         set user process descriptor pointer to $0600
00D0: 8B02                      adda    #$02            set stack pointer to $0800
00D2: 1F04                      tfr     d,s
00D4: 4C                        inca                    set system stack base pointer to $0900
00D5: DDCC                      std     <D.SysStk
00D7: DD4E                      std     <D.SysMem       set system memory map ptr $0900
00D9: 4C                        inca                    set module directory start ptr to $0a00
00DA: DD44                      std     <D.ModDir
00DC: DD58                      std     <D.ModEnd       set module directory end ptr to $0a00
00DE: 8B06                      adda    #$06            set secondary module directory start to $1000
00E0: DD46                      std     <D.ModDir+2
00E2: DD5A                      std     <D.ModDAT       set module directory DAT pointer to $1000
00E4: DDA5                      std     <D.CCMem        set pointer to beginning of global memory to $1000
00E6:                   * In following line, CRC=ON if it is STA <D.CRC, CRC=OFF if it is a STB <D.CRC
00E6: D73B                      stb     <D.CRC          set CRC checking flag to off
