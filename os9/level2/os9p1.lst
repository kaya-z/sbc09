0168: 5F                        clrb
0169:                         ENDC
0169: ED81                      std     ,x++            initialize 1st block to 0 (for this DP)
016B:                   
016B:                   ********************************************************************
016B:                   * The DAT image is a data structure that is used to indicate which
016B:                   * Dynamic Address Translator (DAT) mapping registers are in use.
016B:                   
016B:                   * Dat.BlCt-ROMCount-RAMCount = 8 - 1 - 1 = 6
016B: 8606                      lda     #$06            initialize the rest of the blocks to be free
016D: CE333E                    ldu     #DAT.Free
0170: EF81              L00EF   stu     ,x++            store free "flag"
0172: 4A                        deca                    bump counter
0173: 26FB                      bne     L00EF           loop if not done
0175:                   
0175: CE003F                    ldu     #KrnBlk         Block where the kernel will live
0178: EF84                      stu     ,x
017A:                   
017A: 9E20                      ldx     <D.Tasks        Point to task user table
017C: 6C84                      inc     ,x              mark first 2 in use (system & GrfDrv)
017E: 6C01                      inc     1,x
0180:                   
0180:                   ********************************************************************
0180:                   * The system memory map is a data structure that is used to manage
0180:                   * the 64Kbyte CPU address space. D.SysMem is a pointer to the start
0180:                   * of the map (set to $0900, above) and the map is a fixed size of
0180:                   * 256 bytes. Each byte in the map represents one 256-byte "page"
0180:                   * (256 entries of 256 bytes is 64Kbytes). A value of 0 indicates
0180:                   * an unused page and since the system block has been initialised
0180:                   * to 0 (above) every page starts off marked as unused.
0180:                   * See "Level 2 flags" in os9.d for other byte values.
0180:                   
0180:                   * Update the system memory map to reserve the area used for
0180:                   * global memory.
0180: 9E4E                      ldx     <D.SysMem       Get system memory map pointer
0182: D6A7                      ldb     <D.CCStk        Get MSB of top of CC memory
0184:                   * X indexes the system memory map.
0184:                   * B represents the number of 256-byte pages available.
0184:                   * Walk through the map changing the corresponding elements
0184:                   * from 0 (the initialisation value) to 1 (indicating 'used'). Higher
0184:                   * entries in the map remain as 0 (indicating 'unused').
0184: 6C80              L0104   inc     ,x+             Mark it as used
0186: 5A                        decb                    Done?
0187: 26FB                      bne     L0104           No, go back till done
0189:                   
0189:                   ********************************************************************
0189:                   * Deduce how many 8Kbyte blocks of physical memory are available and
0189:                   * update the memory block map end pointer (D.BlkMap+2) accordingly
0189: 9E40                      ldx     <D.BlkMap       get ptr to 8k block map
018B: 6C883F                    inc     <KrnBlk,x       mark block holding kernel as used
018E:                   * This memory sizing routine uses location at X (D.BlkMap) as
018E:                   * a scratch location. At exit, it leaves this location at 1 which
018E:                   * has the (until now) undocumented side-effect of marking block 0
018E:                   * as used. It is essential that this is done because that block
018E:                   * does need to be reserved; it's used for global memory.
018E:                         IFNE    H6309
018E:                           ldq     #$00080100      e=Marker, D=Block # to check
0191:                   L0111   asld                    get next block #
018E:                           stb     >DAT.Regs+5     Map block into block 6 of my task
018E:                           ste     >-$6000,x       save marker to that block
018E:                           cmpe    ,x              did it ghost to block 0?
018E:                           bne     L0111           No, keep going till ghost is found
018E:                           stb     <D.MemSz        Save # 8k mem blocks that exist
018E:                           addr    x,d             add number of blocks to block map start
018E:                         ELSE
018E: CC0008                    ldd     #$0008
0191: 58                L0111   aslb
0192: 49                        rola
0193: F7FFA5                    stb     >DAT.Regs+5
0196: 3402                      pshs    a
0198: 8601                      lda     #$01
019A: A789A000                  sta     >-$6000,x
019E: A184                      cmpa    ,x
01A0: 3502                      puls    a
01A2: 26ED                      bne     L0111
01A4: D7A3                      stb     <D.MemSz
01A6: 3410                      pshs    x
01A8: E3E1                      addd    ,s++
01AA:                         ENDC
01AA: DD42                      std     <D.BlkMap+2     save memory block map end pointer
01AC:                   
01AC:                   ********************************************************************
01AC:                   * Initial reservation of blocks in the memory block map. Code above
01AC:                   * reserved one block (block 0) for global memory and one block
01AC:                   * (usually block $3F) for krn.
01AC:                   *
01AC:                   * At this point, the value of D indicates the memory size:
01AC:                   * $0210 - 128k  ( 16, 8KByte blocks)
01AC:                   * $0220 - 256k  ( 32, 8KByte blocks)
01AC:                   * $0240 - 512k  ( 64, 8KByte blocks)
01AC:                   * $0280 - 1024k (128, 8KByte blocks)
01AC:                   * $0300 - 2048k (256, 8KByte blocks)
01AC: C530                      bitb    #%00110000      block above 128K-256K?
01AE: 270F                      beq     L0170           yes, no need to mark block map
01B0: 5D                        tstb                    2 meg?
01B1: 270C                      beq     L0170           yes, skip this
01B3:                   * Mark blocks from 128k-256K to block $3F as NOT RAM
01B3: 3A                        abx                     add maximum block number to block map start
01B4: 301F                      leax    -1,x            Skip good blocks that are RAM
01B6: 8680                      lda     #NotRAM         Not RAM flag
01B8: C03F                      subb    #$3F            Calculate # blocks to mark as not RAM
01BA: A780              L0127   sta     ,x+             Mark them all
01BC: 5A                        decb
01BD: 26FB                      bne     L0127
01BF:                   
01BF:                   * ASSUME: however we got here, B=0
01BF: 8EED00            L0170   ldx     #Bt.Start       start address of the boot track in memory
01C2: 8612                      lda     #18             size of the boot track is $1800
01C4:                   
01C4:                   * Verify the modules in the boot track and update/build a module index
01C4: 170773                    lbsr    I.VBlock
01C7: 8D2F                      bsr     L01D2           go mark system map
01C9:                   
01C9:                   * See if init module is in memory already
01C9: 308D0047          L01B0   leax    <init,pc        point to 'Init' module name
01CD: 8D3F                      bsr     link            try & link it
01CF: 2407                      bcc     L01BF           no error, go on
01D1: 103F35            L01B8   os9     F$Boot          error linking init, try & load boot file
01D4: 24F3                      bcc     L01B0           got it, try init again
01D6: 201C                      bra     L01CE           error, re-booting do D.Crash
01D8:                   
01D8:                   * So far, so good. Save pointer to init module and execute krnp2
01D8: DF24              L01BF   stu     <D.Init         Save init module pointer
01DA: A6C81B                    lda     Feature1,u      Get feature byte #1 from init module
01DD: 8501                      bita    #CRCOn          CRC feature on?
01DF: 2702                      beq     ShowI           if not, continue
01E1: 0C3B                      inc     <D.CRC          else inc. CRC flag
01E3:                   
01E3: 8669              ShowI   lda     #'i             debug: signal that we found the init module
01E5: 9D5E                      jsr     <D.BtBug
01E7:                   
01E7: 308D002D          L01C1   leax    <krnp2,pc       Point to its name
01EB: 8D21                      bsr     link            Try to link it
01ED: 2407                      bcc     L01D0           It worked, execute it
01EF: 103F35                    os9     F$Boot          It doesn't exist try re-booting
01F2: 24F3                      bcc     L01C1           No error's, let's try to link it again
01F4: 0E6B              L01CE   jmp     <D.Crash        obviously can't do it, crash machine
01F6: 6EA4              L01D0   jmp     ,y              execute krnp2
01F8:                   
01F8:                   * Update the system memory map to reserve the area used by the kernel
01F8: 9E4E              L01D2   ldx     <D.SysMem       Get system memory map pointer
01FA: CC80ED                    ldd     #NotRAM*256+(Bt.Start/256)      B = MSB of start of the boot
01FD: 3A                        abx                     point to Bt.Start - start of boot track
01FE: 53                        comb                    we have $FF-$ED pages to mark as inUse
01FF: A785                      sta     b,x             Mark I/O as not RAM
0201: 8601              L01DF   lda     #RAMinUse       get inUse flag
0203: A780              L01E1   sta     ,x+             mark this page
0205: 5A                        decb                    done?
0206: 26FB                      bne     L01E1           no, keep going
0208: 9E40                      ldx     <D.BlkMap       get pointer to start of block map
020A: A7883F                    sta     <KrnBlk,x       mark kernel block as RAMinUse, instead of ModInBlk
020D: 39                S.AltIRQ        rts             return
020E:                   
020E:                   * Link module pointed to by X
020E: 86C0              link    lda     #Systm          Attempt to link system module
0210: 103F00                    os9     F$Link
0213: 39                        rts
