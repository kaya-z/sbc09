0122: 9FC4                      stx     <D.SysIRQ
0124: 9FE8                      stx     <D.XIRQ
0126:                   
0126: 308D0CC7                  leax    >S.SvcIRQ,pc    Setup in system IRQ service vector
012A: 9FCE                      stx     <D.SvcIRQ
012C: 308D046A                  leax    >S.Poll,pc      Setup interrupt polling vector
0130: 9F26                      stx     <D.Poll         ORCC #$01;RTS
0132: 308D00D7                  leax    >S.AltIRQ,pc    Setup alternate IRQ vector: pts to an RTS
0136: 9FB2                      stx     <D.AltIRQ
0138:                   
