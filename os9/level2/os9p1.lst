0841:                   **************************************************
0841:                   * System Call: F$SRqMem
0841:                   *
0841:                   * Function: Request memory
0841:                   *
0841:                   * F$SRqMem allocates memory from the system's 64K address space in 256 byte 'pages.'
0841:                   * There are 256 of these '256 byte pages' in the system's RAM area (256*256=64K).
0841:                   * The allocation map, pointed to by D.SysMem holds one byte per page, making the
0841:                   * allocation map itself 256 bytes in size.
0841:                   *
0841:                   * Memory is allocated from the top of the system RAM map downwards.  Rel/Boot/Krn
0841:                   * also reside in this area, and are loaded from $ED00-$FFFF.  Since this area is
0841:                   * always allocated, we start searching for free pages from page $EC downward.
0841:                   *
0841:                   * F$SRqMem also updates the system memory map according to 8K DAT blocks. If an
0841:                   * empty block is found, this routine re-does the 32 entries in the SMAP table to
0841:                   * indicate that they are free.
0841:                   *
0841:                   * Input:  D = Byte count
0841:                   *
0841:                   * Output: U = Address of allocated memory area
0841:                   *
0841:                   * Error:  CC = C bit set; B = error code
0841:                   *
0841: EC41              FSRqMem  ldd   R$D,u        get memory allocation size requested
0843: C300FF                     addd  #$00FF       round it up to nearest 256 byte page (e.g. $1FF = $2FE)
0846: 5F                         clrb               just keep # of pages (and start 8K block #, e.g. $2FE = $200)
0847: ED41                       std   R$D,u        save rounded version back to user
0849:                   *         leay  Bt.Start/256,y
0849:                   *         leay  $20,y        skip Block 0 (always reserved for system)
0849:                   * Change to pshs a,b:use 1,s for block # to check, and ,s for TFM spot
0849:                   *         incb               skip block 0 (always reserved for system)
0849: 3406                       pshs  d            reserve a byte & put 0 byte on stack
084B:                   
084B:                   
084B:                   * IMPORTANT!!!
084B:                   * The following code was put in some time back to fix a problem.  That problem was not documented
084B:                   * so I cannot recall why this code was in place.  What it appears to do is reset the system page
084B:                   * memory map based upon the state of the system DAT image.
084B:                   * This code really slows down F$SRqMem and since that system call is used quite often in the system,
084B:                   * I am commenting it out in the hopes that I can remember what the hell I put it in for. -- Boisy
084B:                            IFEQ  1
084B:                            ldy   <D.SysMem    get ptr to SMAP table
084B:                   * This loop updates the SMAP table if anything can be marked as unused
0000:                   L082F    ldx   <D.SysDAT    get pointer to system DAT block list
084B:                            lslb               adjust block offset for 2 bytes/entry
084B:                            ldd   b,x          get block type/# from system DAT
084B:                            cmpd  #DAT.Free    Unused block?
084B:                            beq   L0847        yes, mark it free in SMAP table
084B:                            ldx   <D.BlkMap    No, get ptr to MMAP table
084B:                            lda   d,x          Get block marker for 2 meg mem map
084B:                            cmpa  #RAMinUse    Is it in use (not free, ROM or used by module)?
084B:                            bne   L0848        No, mark it as type it is in SMAP table
084B:                            leay  32,y         Yes, move to next block in pages
084B:                            bra   L084F        move to next block & try again
084B:                   * Free RAM:
0000:                   L0847    clra               Byte to fill system page map with (0=Not in use)
084B:                   * NOT! RAMinUse:
084B:                            IFNE   H6309
0000:                   L0848    sta   ,s           Put it on stack
084B:                            ldw   #$0020       Get size of 8K block in pages
084B:                            tfm   s,y+         Mark entire block's worth of pages with A
084B:                            ELSE
0000:                   L0848    ldb   #32          count = 32 pages
0000:                   L084A    sta   ,y+          mark the RAM
084B:                            decb
084B:                            bne    L084A
084B:                            ENDC
0000:                   L084F    inc   1,s          Bump up to next block to check
084B:                            ldb   1,s          Get it
084B:                            cmpb  #DAT.BlCt    Done whole 64k system space?
084B:                            blo   L082F        no, keep checking
084B:                            ENDC
084B:                   
084B:                   
084B:                   * Now we can actually attempt to allocate the system RAM requested
084B:                   * NOTE: Opt for CoCo/TC9 OS9 ONLY: skip last 256 - Bt.Start pages since
084B:                   * they are: Kernel (REL/BOOT/KRN - 17 pages), vector RAM & I/O (2 pages)
084B:                   * (Already permanently marked @ L01D2)
084B:                   * At the start, Y is pointing to the end of the SMAP table+1
084B: 9E4E                       ldx   <D.SysMem    Get start of table ptr
084D: 318900ED                   leay  Bt.Start/256,x
0851: C620                       ldb   #32          skip block 0: it's always full
0853: 3A                         abx                same size, but faster than leax $20,x
0854:                   *         leay  -(256-(Bt.Start>>8)),y  skip Kernel, Vector RAM & I/O (Can't be free)
0854: E641              L0857    ldb   R$A,u        Get # 256 byte pages requested
0856:                   * Loop (from end of system mem map) to look for # continuous pages requested
0856:                   L0859    equ   *
0856:                            IFNE  H6309
0856:                            cmpr  x,y          We still have any system RAM left to try?
0856:                            ELSE
0856: 3410                       pshs  x
0858: 10ACE1                     cmpy  ,s++
085B:                            ENDC
085B: 2205                       bhi   L0863        Yes, continue
085D: 53                         comb               Exit with No System RAM Error
085E: C6ED                       ldb   #E$NoRAM
0860: 2031                       bra   L0894        Eat stack & exit
0862:                   
0862: A6A2              L0863    lda   ,-y          Get page marker (starting @ end of SMAP)
0864: 26EE                       bne   L0857        Used, try next lower page
0866: 5A                         decb               Found 1 page, dec # pages we need to allocate
0867: 26ED                       bne   L0859        Still more pages needed, check if we can get more
0869: 10AFE4                     sty   ,s           Found free contiguous pages, save SMAP entry ptr
086C: A661                       lda   1,s          Get LSB of ptr
086E: 44                         lsra               Divide by 32 (Calculate start 8K block #)
086F: 44                         lsra
0870: 44                         lsra
0871: 44                         lsra
0872: 44                         lsra
0873: E661                       ldb   1,s          Get LSB of ptr again
0875: C41F                       andb  #%00011111   Keep only within 8K block offset
0877: EB41                       addb  R$A,u        Add # pages requested
0879: CB1F                       addb  #$1F         Round up to nearest 8K block
087B: 54                         lsrb               Divide by 32 (Calculate end 8K block #)
087C: 54                         lsrb
087D: 54                         lsrb
087E: 54                         lsrb
087F: 54                         lsrb
