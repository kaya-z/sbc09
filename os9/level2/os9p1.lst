00A1:                           ldq     #$01001f00      start address to clear & # bytes to clear
00A1:                           leay    <entry+2,pc     point to a 0
00A1:                           tfm     y,d+
00A1:                           std     <D.CCStk        set pointer to top of global memory to $2000
00A1:                           lda     #$01            set task user table to $0100
00A1:                         ELSE
00A1: 8E0100                    ldx     #$100           start address
00A4: 108E1F00                  ldy     #$2000-$100     bytes to clear
00A8: 4F                        clra
00A9: 5F                        clrb
