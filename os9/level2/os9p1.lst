00E8:                   * Initialize interrupt vector tables, move pointer data down to DP
00E8: 318C8D                    leay    <DisTable,pcr   point to table of absolute vector addresses
00EB: 8E00E0                    ldx     #D.Clock        where to put it in memory
00EE:                           IFNE    H6309
00EE:                           ldf     #DisSize        size of the table - E=0 from TFM, above
00EE:                           tfm     y+,x+           move it over
00EE:                           ELSE
00EE: C612                      ldb     #DisSize
00F0:                   l@
00F0: A6A0                      lda     ,y+             load a byte from source
00F2: A780                      sta     ,x+             store a byte to dest
00F4: 5A                        decb                    bump counter
00F5: 26F9                      bne     l@              loop if we're not done
00F7:                           ENDC
00F7:                   
00F7:                   * Initialize D.Flip0 routine in low memory by copying lump of code down from R.Flip0.
00F7:                   * ASSUME: Y left pointing to R.Flip0 by previous copy loop.
00F7:                   
00F7: CE0160                    ldu     #LowSub         somewhere in block 0 that's never modified
00FA: DFA9                      stu     <D.Flip0        switch to system task 0
