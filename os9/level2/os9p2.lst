0012: 13                         fcb    Edition
0013:                   
0013:                            IFEQ   TC9-1
0013:                   * Entry: None
0013:                   * Exit : Process killed & register dump produced for user
0001:                   Trap     bitmd  #%01000000  illegal instruction?
0013:                            bne    BadIns      yes, go process
0013:                            bitmd  #%10000000  division by 0?
0013:                            bne    Div0        yes, go process
0013:                            jmp    [<D.XSWI]   act as if nothing happened
0013:                   
0013:                   * Process illegal instruction trap
0040:                   BadIns   bsr    SetProc     move the register stack here
0013:                   
0013:                   
0013:                   
0013:                   
0013:                   
0013:                            ldb    #18         get error code for F$Exit
0013:                            bra    TrapDone
0013:                   * Process division by 0 trap
0080:                   Div0     bsr    SetProc     move the register stack
0013:                   
0013:                   
0013:                   
0013:                   
0013:                            ldb    #45         get error code for F$Exit
0013:                   
0013:                   * Return to system after the trap
0013:                   * Entry: B=Error code
0013:                   *        U=Pointer to register stack
0001:                   TrapDone stb    R$B,u       save the error code to register stack for F$Exit
0013:                            lbra   FExit       enter F$Exit directly
0013:                   
0013:                   * Set process to system state & copy register stack for trap processing
0040:                   SetProc  ldd    <D.SysSvc   set system call processor to system side
0013:                            std    <D.XSWI2
0013:                            ldd    <D.SysIRQ   do the same thing for IRQ's
0013:                            std    <D.XIRQ
0013:                            ldx    <D.Proc     get current process pointer
0013:                            IFNE   H6309
0013:                            oim    #SysState,P$State,x   mark process as system state
0013:                            ELSE
0013:                            ldb    P$State,x
0013:                            orb    #SysState
0013:                            stb    P$State,x
0013:                            ENDC
0013:                   * copy register stack to process descriptor
0013:                            sts    P$SP,x      save stack pointer
0013:                            leas   (P$Stack-R$Size),x point S to register stack destination
0013:                            andcc  #^IntMasks  force interrupts back on
0013:                            leau   ,s          point to destination register stack
0013:                            ldb    P$Task,x    get task # of destination
0013:                            ldx    P$SP,x      get the user/system stack pointer
0013:                            pshs   b           preserve task for a moment
0013:                            tfr    x,d         copy it for easier calcs
0013:                            bita   #%11100000  offset above block 0?
0013:                            beq    done        yes, no calc needed get out
0013:                            anda   #%00011111  make it a offset within a block
0013:                            tfr    d,x         copy new offset
0013:                            lsra               make A an offset into DAT image
0013:                            lsra
0013:                            lsra
0013:                            lsra
0010:                   done     puls   b           restore task #
0013:                            leax   -$6000,x    make it a pointer to where I'll map the block
0013:                            tfr    u,y
0013:                            pshs   cc,u        preserve IRQ status & dest pointer
0013:                            ldu    <D.TskIPt
0013:                            lslb               adjust task # to fit table
0013:                            ldu    b,u         get the DAT image pointer
0013:                            leau   a,u         point to the blocks needed
0013:                            lda    1,u         get 1st block
0013:                            ldb    3,u         get a second in case of overlap
0013:                            orcc   #IntMasks   shut IRQ's down
0013:                            std    >DAT.Regs+5 map in the blocks
0013:                            IFNE   H6309
0013:                            ldw    #R$Size     get size of register stack
0013:                            tfm    x+,y+       move 'em to process descriptor
0013:                            ELSE
0013:                            ldb    #R$Size
0040:                   Uday     lda    ,x+
0013:                            sta    ,y+
0013:                            decb
0013:                            bne    Uday
0013:                            ENDC
0013:                            ldx    <D.SysDAT   get the system DAT image pointer
0013:                            lda    $0B,x       get the original blocks
0013:                            ldb    $0D,x
0013:                            std    >DAT.Regs+5 map 'em back in
0013:                            puls   cc,u,pc     restore IRQ's, register stack pointer & return
0013:                        ENDC
