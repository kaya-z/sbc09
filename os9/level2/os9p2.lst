0815:                   **************************************************
0815:                   * System Call: F$CpyMem
0815:                   *
0815:                   * Function: Copy external memory
0815:                   *
0815:                   * Input:  D = Starting memory block number
0815:                   *         X = Offset in block to begin copy
0815:                   *         Y = Byte count
0815:                   *         U = Caller's destination buffer
0815:                   *
0815:                   * Output: None
0815:                   *
0815:                   * Error:  CC = C bit set; B = error code
0815:                   *
0815:                            IFNE  H6309
0815:                   * F$CpyMem for NitrOS-9 Level Two
0815:                   * Notes:
0815:                   * We currently check to see if the end of the buffer we are
0815:                   * copying to will overflow past $FFFF, and exit if it does.
0815:                   * Should this be changed to check if it overflows past the
0815:                   * data area of a process, or at least into Vector page RAM
0815:                   * and I/O ($FE00-$FFFF)???
0815:                   *
0815:                   FCpyMem  ldd   R$Y,u        get byte count
0815:                            beq   L0A01        nothing there so nothing to move, return
0815:                            addd  R$U,u        add it caller's buffer start ptr.
0815:                            cmpa  #$FE         Is it going to overwrite Vector or I/O pages?
0815:                            bhs   L0A01        Yes, exit without error
0815:                            leas  -$10,s       make a buffer for DAT image
0815:                            leay  ,s           point to it
0815:                            pshs  y,u          Preserve stack buffer ptr & register stack pointer
0815:                            ldx   <D.Proc      Get caller's task #
0815:                            ldf   P$Task,x     get task # of caller
0815:                            leay  P$DATImg,x   Point to DAT image in callers's process dsc.
0815:                            ldx   R$D,u        get caller's DAT image pointer
0815:                            lde   #$08         counter (for double byte moves)
0815:                            ldu   ,s           get temp. stack buffer pointer
0815:                   
0815:                   * This loop copies the DAT image from the caller's process descriptor into
0815:                   * a temporary buffer on the stack
0834:                   L09C7    equ   *
0815:                            clrd               Clear offset to 0
0815:                            bsr   L0B02         Short cut OS9 F$LDDDXY
0815:                            std   ,u++         save it to buffer
0815:                            leax  2,x          Bump ptr
0815:                            dece               Decrement loop counter
0815:                            bne   L09C7        Keep doing until 16 bytes is done
0815:                   
0815:                            ldu   2,s          Get back register stack pointer
0815:                            lbsr  L0CA6        Short cut OS9 F$ResTsk
0815:                            bcs   L09FB        If error, deallocate our stack & exit with error
0815:                            tfr   b,e          New temp task # into E
0815:                            lslb               Multiply by 2 for 2 byte entries
0815:                            ldx   <D.TskIPt    Get ptr to task image table
0815:                   * Make new temporary task use the memory blocks from the requested DAT image
0815:                   *   from the caller, to help do a 1 shot F$Move command, because in general
0815:                   * the temporary DAT image is not associated with a task.
0815:                            ldu   ,s           Get pointer to DAT image we just copied
0815:                            stu   b,x          Point new task image table to our DAT image copy
0815:                            ldu   2,s          Get back data area pointer
0815:                            tfr   w,d          Move temp & caller's task #'s into proper regs.
0815:                            pshs  a            Save new task #
0815:                            bsr   L0B25        F$Move the memory into the caller's requested area
0815:                   * BAD Bug! Well, maybe not.  F$Move NEVER returns an error code
0815:                   * but if it did, we'd skip the $RelTsk, and have an orphan task
0815:                   * left over.
0815:                   *         bcs   L09FB        If error, purge stack & return with error code
0815:                            puls  b            Get back new task #
0815:                            lbsr  L0CC3        Short cut OS9 F$RelTsk
0000:                   L09FB    leas  <$14,s       Purge our stack buffer & return
0815:                            rts
0815:                   
086E:                   L0A01    clrb               No error & exit
0815:                            rts
0815:                   
0815:                   
0815:                            ELSE
0815:                   
0815:                   * F$CpyMem for OS-9 Level Two
