0011:                   
0011:                   * Default input buffer setting for SCF devices when Opened/Created
0011:                   *               123456789!123456789!1234567890
0011:                   *msg      fcc   'by B.Nobel,C.Boyle,W.Gale-1993'
0011: 7777772E6E697472  msg      fcc   'www.nitros9.org'
001A: 73392E6F7267
000F:                   msgsize  equ   *-msg        Size of default input buffer message
0020: 0D                         fcb   C$CR         2nd CR for buffer pad fill
00F1:                   blksize  equ   256-msgsize  Size of blank space after it
0021:                   
0021:                   * Return bad pathname error
0021: 3520              opbpnam  puls  y
0023: 53                bpnam    comb               Set carry for error
0024: C6D7                       ldb   #E$BPNam     Get error code
0026: 39                oerr     rts                Return to caller
0027:                   
0027:                   * I$Create/I$Open entry point
0027:                   * Entry: Y= Path dsc. ptr
0027: AE23              open     ldx   PD.DEV,y     Get device table pointer
0029: AFA9003B                   stx   PD.TBL,y     Save it
002D: EE26                       ldu   PD.RGS,y     Get callers register stack pointer
002F: 3420                       pshs  y            Save path descriptor pointer
0031: AE44                       ldx   R$X,u        Get pointer to device pathname
0033: 103F10                     os9   F$PrsNam     Parse it
0036: 25E9                       bcs   opbpnam      Error, exit
0038: 4D                         tsta               End of pathname?
0039: 2B07                       bmi   open1        Yes, go on
003B: 30A4                       leax  ,y           Point to actual device name
003D: 103F10                     os9   F$PrsNam     Parse it again
0040: 24DF                       bcc   opbpnam      Return to caller with bad path name if more
0042: 10AF44            open1    sty   R$X,u        Save updated name pointer to caller
0045: 3520                       puls  y            Restore path descriptor pointer
0047: CC0100                     ldd   #256         Get size of input buffer in bytes
004A: 103F28                     os9   F$SRqMem     Allocate it
004D: 25D7                       bcs   oerr         Can't allocate it return with error
004F: EF28                       stu   PD.BUF,y     Save buffer address to path descriptor
0051: 308CBD                     leax  <msg,pc      Get ptr to init string
0054:                   
0054:                            IFNE  H6309
0054:                   
0054:                            ldw   #msgsize     get size of default message
0054:                            tfm   x+,u+        Copy it into buffer (leaves X pointing to 2nd CR)
0054:                            ldw   #blksize     Size of rest of buffer
0054:                            tfm   x,u+         Fill rest of buffer with CR's
0054:                   
0054:                            ELSE
0054:                   
0054: A680              CopyMsg  lda   ,x+
0056: A7C0                       sta   ,u+
0058: 5A                         decb
0059: 810D                       cmpa  #C$CR
005B: 26F7                       bne   CopyMsg
005D: A7C0              CopyCR   sta   ,u+
