007F: 3420                       pshs  y            Save path descriptor pointer temporarily
0081: 109E50                     ldy   <D.Proc      Get current process pointer
0084: DE4A                       ldu   <D.SysPrc    Get system process descriptor pointer
0086: DF50                       stu   <D.Proc      Make system current process
0088:                            ENDC
0088: 103F80                     os9   I$Attach     Attempt to attach to device name in device desc.
008B:                            IFGT  Level-1
008B: 109F50                     sty   <D.Proc      Restore old current process pointer
008E: 3520                       puls  y            Restore path descriptor pointer
0090:                            ENDC
0090: 2557                       bcs   OpenErr     Couldn't attach to device, detach & exit with error
0092: EF2A                       stu   PD.DV2,y     Save new output (echo) device table pointer
0094:                   *         ldu   PD.DEV,y     Get device table pointer
0094: EE42              L00CF    ldu   V$STAT,u     Point to it's static storage
0096:                   
0096:                            IFNE  H6309
0096:                   
0096:                            clrd
