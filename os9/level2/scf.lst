0129:                   RemoveFromPDList
0129: 8E0001                     ldx   #1
012C: 3477                       pshs  cc,d,x,y,u
012E: EE23                       ldu   PD.DEV,y     Get device table pointer
0130: 2729                       beq   L017B        None, skip ahead
0132: EE42                       ldu   V$STAT,u     Get static storage pointer
0134: 2725                       beq   L017B        None, skip ahead
0136: AEC816                     ldx   V.PDLHd,u    Get path descriptor list header
0139: 2720                       beq   L017B        None, skip ahead
013B: ECA83D                     ldd   PD.PLP,y     Get path descriptor list pointer
013E: 10ACC816                   cmpy  V.PDLHd,u    is the passed path descriptor the same?
0142: 260E                       bne   L0172        branch if not
0144: EDC816                     std   V.PDLHd,u
0147: 2612                       bne   L017B
