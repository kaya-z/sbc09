09A0:                   * 6551 Parameters
0004:                   ADDR     equ   $FF68     
09A0:                   
0000:                   A_RXD    equ   ADDR+$00
0000:                   A_TXD    equ   ADDR+$00
0000:                   A_STATUS equ   ADDR+$01
0000:                   A_RESET  equ   ADDR+$01
0000:                   A_CMD    equ   ADDR+$02
0000:                   A_CTRL   equ   ADDR+$03
09A0:                                            
09A0:                   * Baud rates
09A0:                   _B2400    equ   $1A      2400 bps, 8-N-1
09A0:                   _B4800    equ   $1C      4800 bps, 8-N-1
09A0:                   _B9600    equ   $1E      9600 bps, 8-N-1
09A0:                   _B19200   equ   $1F      19200 bps, 8-N-1
09A0:                   
092B:                   BAUD     equ   _B9600
09A0:                   
09A0:                   * Init - Initialize
09A0:                   * Exit: Carry = 0: Init success; Carry = 1; Init failed
000E:                   Init                     
09A0:                            sta   A_RESET    soft reset (value not important)
09A0:                   * Set specific modes and functions:
09A0:                   * - no parity, no echo, no Tx interrupt
09A0:                   * no Rx interrupt, enable Tx/Rx
09A0:                            lda   #$0B
09A0:                            sta   A_CMD      save to command register
09A0:                            lda   #BAUD
09A0:                            sta   A_CTRL     select proper baud rate
09A0:                   * Read any junk rx byte that may be in the register
09A0:                            lda   A_RXD
09A0:                            rts             
09A0:                                            
09A0:                   * Read - Read one character
09A0:                   * Exit:  A = character that was read
0001:                   Read                     
0001:                   r@       lda   A_STATUS   get status byte
09A0:                            anda  #$08       mask rx buffer status flag
09A0:                            beq   r@         loop if rx buffer empty
09A0:                            lda   A_RXD      get byte from ACIA data port
09A0:                            rts             
09A0:                                            
09A0:                   * Write - Write one character
09A0:                   * Entry: A = character to write
0002:                   Write                    
09A0:                            pshs  a          save byte to write
063C:                   w@       lda   A_STATUS   get status byte
09A0:                            anda  #$10       mask tx buffer status flag
09A0:                            beq   w@         loop if tx buffer full
09A0:                            puls  a          get byte
09A0:                            sta   A_TXD      save to ACIA data port
09A0:                            rts             
09A0:                                            
09A0:                   * Term - Terminate
0020:                   Term                     
09A0:                            rts             
09A0:                                            
09A0:                   
09A0:                   * llwout - Write an entire string
09A0:                   * llwerr - Write an entire string
0988:                   llwerr
098B:                   llwout
09A0:                            pshs  a
019C:                   l@       lda   ,x+
09A0:                            cmpa  #C$CR
09A0:                            beq   e@
09A0:                            leay  -1,y
09A0:                            beq   f@
09A0:                            bsr   Write
09A0:                            bra   l@
0135:                   e@       bsr   Write
09A0:                            lda   #C$LF
09A0:                            bsr   Write
0000:                   f@       ldx   <buffptr
09A0:                            clrb
09A0:                            puls  a,pc
09A0:                   
09A0:                   * ReadLine - Read an entire string, up to CR
09A0:                   * Entry: X = address to place string being read (CR terminated)
09A0:                   *        Y = maximum number of bytes to read (including nul byte)
0993:                   ReadLine
09A0:                            ldx   <buffptr
09A0:                            pshs  y,x,a
09A0:                            ldy   #80
019C:                   l@       bsr   Read         read 1 character
09A0:                            cmpa  #C$CR        carriage return?
09A0:                            beq   e@           branch if so...
09A0:                            cmpa  #$08         backspace?
09A0:                            beq   bs@           
09A0:                            cmpy  #$0000       anymore room?
09A0:                            beq   l@
09A0:                            leay  -1,y         back up one char
09A0:                            sta   ,x+          and save in input buffer
0000:                   m@       bsr   Write        echo back out
09A0:                            bra   l@
0135:                   e@       sta   ,x
09A0:                            bsr   Write
09A0:                            lda   #C$LF
09A0:                            bsr   Write
09A0:                            clrb
09A0:                            puls  a,x,y,pc
003B:                   bs@      cmpx  1,s          are we at start
09A0:                            beq   l@           if so, do nothing
09A0:                            clr   ,-x          else erase last byte
