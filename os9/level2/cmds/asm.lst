0000:                   
0000:                   * u002B Bit flag meanings: (Default=00110101)
0080:                   LitLine  equ   %10000000      Literal line to print
0040:                   Comment  equ   %01000000      Comment field present in source line
0020:                   Operand  equ   %00100000      Operand field present in source line
0010:                   Command  equ   %00010000      Mnemonic command present in source line
0008:                   Label    equ   %00001000      Label field present in source line
0004:                   NoObjct  equ   %00000100      No object code to print
0001:                   PrintPC  equ   %00000001      Print PC flag
0000:                   DoNothng equ   %00000000      Do nothing (no flags set)
0000:                   
0000:                           IFNE  NEWDEF
00A2:                   Numop    equ   162            # of opcodes in table (including pseudo-ops)
0000:                           ELSE
00A2:                   Numop    equ   160            # of opcodes in table (including pseudo-ops)
0000:                           ENDC  NEWDEF
0000:                   
0000:                   * Notes on symbol table entries:
0000:                   * There are two tables - one is pointed to by <u0010 (which is either 26 or 52 entries), each of which
0000:                   * points to a linked list of symbol table entries that start with that letter (26 entries if uppercase
0000:                   * only, 52 entries is upper/lowercase are treated separate). Each entry is 15 bytes:
0000:                   * $0-$7   : 8 char symbol name
0000:                   * $8      : Symbol type (0=undefined, 1=label, 2=SET, 3=EQU, 4=Data)
0000:                   * $9-$A   : value of symbol
0000:                   * $B-$C   : Linked list ptr to next "lower" (alphabetical) symbol tbl entry (within current start letter)
0000:                   * $D-$E   : Linked list ptr to next "greater" (alphabetical) symbol tbl entry (within current start letter)
0000:                   * A value of $0000 in the linked list pointers means no further ones in that direction
0000:                   
0000:                   u0000    rmb   2              Ptr to source line input buffer (80 + CR)
0002:                   u0002    rmb   2              Ptr to header output buffer    (132 + CR)
0004:                   u0004    rmb   2              Ptr to listing output buffer   (132 + CR)
0006:                   u0006    rmb   2              Ptr to open file path stack    (13, Ustk)
0008:                   u0008    rmb   2              Ptr to Title buffer (TTL, 79 chars + nul)
000A:                   u000A    rmb   2              Ptr to Name buffer  (NAM, 39 chars + nul)
000C:                   u000C    rmb   1              temp postbyte storage for 6309 bit ops
000D:                           IFNE  DOCASE
000D:                   u000D    rmb   1              symbol case mask (was unused)
000E:                           ELSE
000D:                   u000D    rmb   1              unused
000E:                           ENDC  DOCASE
000E:                   u000E    rmb   2              Ptr to object code buffer (256 bytes)
0010:                   u0010    rmb   2              Ptr to symbol first letter index table (26 or 52 entries, depending)
0012:                   u0012    rmb   2              Ptr to end of symbol table
0014:                   u0014    rmb   2              Ptr to end of listing buffer
0016:                   u0016    rmb   2              Ptr to symbol name buffer (8 chars + nul)
0018:                   u0018    rmb   1              Path number of current source file
0019:                   u0019    rmb   1              Path number of object file, O flag
001A:                   u001A    rmb   1              Path number of output listing (stdout)
001B:                   u001B    rmb   2              Ptr into object code buffer
001D:                   u001D    rmb   2              Ptr to next empty symbol table slot
001F:                   u001F    rmb   2              Open file path stack ptr
0021:                   u0021    rmb   1              Error count for current line
0022:                   u0022    rmb   2              Total warnings
0024:                   u0024    rmb   2              Total program bytes generated
0026:                   u0026    rmb   2              Total data bytes allocated
0028:                   u0028    rmb   2              Total errors
002A:                   u002A    rmb   1
002B:                   u002B    rmb   1              Listing Print Control Bit flags
002C:                   u002C    rmb   1              Data space ops in current line
002D:                   u002D    rmb   2              Ptr to last symbol found/added (scratch)
002F:                   u002F    rmb   2              Ptr to start of current mnemonic
0031:                   u0031    rmb   2              Ptr to next field (or operand start)
0033:                   u0033    rmb   2
0035:                   u0035    rmb   1              # lines to end of page
0036:                   u0036    rmb   1              Page height (default=66), D flag
0037:                   u0037    rmb   1              Page width (default=80), W flag
0038:                   u0038    rmb   2              line counter
003A:                   u003A    rmb   2              page number
003C:                   u003C    rmb   1
003D:                   u003D    rmb   1
003E:                   u003E    rmb   1              Pass counter
003F:                   u003F    rmb   1              Current SetDP value (defaults to 0)
0040:                   u0040    rmb   2              Current code address ('*')
0042:                   u0042    rmb   2              Current data address ('.')
0044:                   u0044    rmb   2
0046:                   u0046    rmb   1              # bytes in current instruction
0047:                   u0047    rmb   1              Current instructions flags/index handler byte
0048:                   u0048    rmb   1
0049:                   u0049    rmb   1
004A:                   u004A    rmb   1              MSB of 16 bit # (for addresses & offsets)
004B:                   u004B    rmb   1              LSB of 16 bit #
004C:                   u004C    rmb   1              Flag for DP (or 8 bit)($01), Extended (or 16 bit)($FF) or other($00) modes
004D:                   u004D    rmb   1              Indirect mode flag (0=no, >0=Yes)
004E:                   u004E    rmb   1              Indexed mode calc completed flag (0=no)
004F:                   u004F    rmb   1              Warning count for current line
0050:                   u0050    rmb   1              Header parity byte
0051:                   u0051    rmb   3              CRC buffer
0054:                   u0054    rmb   1              Inactive (non-coding) nested IF depth
0055:                   u0055    rmb   1              Active (code enabled) nested IF depth
0056:                   u0056    rmb   1              L opt flag
0057:                   u0057    rmb   1
0058:                   u0058    rmb   1              O opt flag
0059:                   u0059    rmb   1              F opt flag
005A:                   u005A    rmb   1              M opt flag
005B:                   u005B    rmb   1              G opt flag
005C:                   u005C    rmb   1              E opt flag
005D:                   u005D    rmb   1              I opt flag
005E:                   u005E    rmb   1              S opt flag
005F:                   u005F    rmb   1              C opt flag
0060:                   u0060    rmb   1              N opt flag
0061:                   * The currently assembled instruction goes here
0061:                   u0061    rmb   1              Current instruction's pre-byte (see u0046)
0062:                   u0062    rmb   1              Current instruction's opcode
0063:                   u0063    rmb   1              More bytes as needed by instruction
0064:                   u0064    rmb   1
0065:                   u0065    rmb   2
0067:                   TmpNum   rmb   2              1 or 2 byte scratch area to use instead of stack for speed.
0069:                   OpTable  rmb   2              Pointer to L03B8 (opcode) table, for slightly faster access
006B:                   SkipCRC  rmb   1              Flag:0=calculate CRC, <>0=don't calculate. Will be<>0 if L1323 is called from L159F
006C:                            rmb   4096-.         Main buffer area
