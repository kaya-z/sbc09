0000:                   * ------------------------------------------------------------------
0000:                   *   1      2003/01/20  Boisy G. Pitre
0000:                   * Rewritten in assembly for size.
0000:                   
0000:                            nam   Cmp
0000:                            ttl   Binary file comparison utility
0000:                   
0000:                            ifp1
0000:                            use   defsfile
0000:                            endc
0000:                   
0000:                   * Here are some tweakable options
0000:                   DOHELP   set   0        1 = include help info
0400:                   CMPBUFSZ set   1024
0080:                   STACKSZ  set   128      estimated stack size in bytes
0100:                   PARMSZ   set   256      estimated parameter size in bytes
0000:                   
0000:                   * Module header definitions
0011:                   tylg     set   Prgrm+Objct   
0080:                   atrv     set   ReEnt+rev
0000:                   rev      set   $00
0001:                   edition  set   1
0000:                   
0000: 87CD027C000D1180           mod   eom,name,tylg,atrv,start,size
0009: 009B09B8
0000:                   
0000:                            org   0
0000:                   headdone rmb   1        if 1, means byte  #1 #2 header shown
0001:                   noneflag rmb   1        if 1, means there were differences
0002:                   f1path   rmb   1        file 1 path
0003:                   f2path   rmb   1        file 2 path
0004:                   f1read   rmb   2
0006:                   f2read   rmb   2
0008:                   f1namptr rmb   2
000A:                   f2namptr rmb   2
000C:                   f1namsiz rmb   2
000E:                   f2namsiz rmb   2
0010:                   cmpbytes rmb   4        bytes compared
0014:                   difbytes rmb   4        bytes different
0018:                   cleartop equ   .        everything up to here gets cleared at start
0018:                   diffbuff rmb   32
0038:                   f1buff   rmb   CMPBUFSZ
0438:                   f2buff   rmb   CMPBUFSZ
0838:                   * Finally the stack for any PSHS/PULS/BSR/LBSRs that we might do
0838:                            rmb   STACKSZ+PARMSZ
09B8:                   size     equ   .
