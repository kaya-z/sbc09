007C:                   
007C:                   * Here's how registers are set when this process is forked:
007C:                   *
007C:                   *   +-----------------+  <--  Y          (highest address)
007C:                   *   !   Parameter     !
007C:                   *   !     Area        !
007C:                   *   +-----------------+  <-- X, SP
007C:                   *   !   Data Area     !
007C:                   *   +-----------------+
007C:                   *   !   Direct Page   !
007C:                   *   +-----------------+  <-- U, DP       (lowest address)
007C:                   *
007C:                   *   D = parameter area size
007C:                   *  PC = module entry point abs. address
007C:                   *  CC = F=0, I=0, others undefined
007C:                   
007C:                   * This routine skip over spaces and commas
007C:                   *
007C:                   * Entry:
007C:                   *   X = ptr to data to parse
007C:                   * Exit:
007C:                   *   X = ptr to first non-whitespace char
007C:                   *   A = non-whitespace char
007C: A680              SkipSpcs lda   ,x+
007E: 8120                       cmpa  #C$SPAC
0080: 27FA                       beq   SkipSpcs
0082: 301F                       leax  -1,x
0084: 39                         rts
0085:                   
0085:                   * This routine counts the number of non-whitespace characters
0085:                   * starting at X
0085:                   *
0085:                   * Entry:
0085:                   *   X = ptr to string (space, comma or CR terminated)
0085:                   * Exit:
0085:                   *   Y = length of string
0085:                   *   X = ptr to byte after string
0085: 3402              StrLen   pshs  a
0087: 108E0000                   ldy   #$0000
008B: A680              StrLenLp lda   ,x+
008D: 8120                       cmpa  #C$SPAC
008F: 2708                       beq   StrLenEx
0091: 810D                       cmpa  #C$CR
0093: 2704                       beq   StrLenEx
0095: 3121                       leay  1,y
0097: 20F2                       bra   StrLenLp
0099: 3582              StrLenEx puls  a,pc
009B:                   
009B:                   * The start of the program is here.
009B:                   * Before any command line processing is done, we clear out
009B:                   * our static memory from U to cleartop, then determine the
009B:                   * size of our data area (minus the stack).
009B: 3450              start    pshs  u,x              save registers for later
009D: 30C818                     leax  <cleartop,u      point to end of area to zero out
00A0:                            IFNE  H6309
00A0:                            subr  u,x              subtract U from X
00A0:                            tfr   x,w              and put X in W
00A0:                            clr   ,-s              put a zero on the stack
00A0:                            tfm   s,u+             and use TFM to clear starting at U
00A0:                            leas  1,s              clean up the stack
00A0:                            ELSE
00A0: 3410                       pshs   x               save end pointer on stack
00A2: 6FC0              clrnxt   clr   ,u+              clear out
00A4: 11A3E4                     cmpu  ,s               done?
00A7: 26F9                       bne   clrnxt           branch if not
00A9: 3262                       leas  2,s              else clear stack
00AB:                            ENDC
00AB: 3550                       puls  x,u              and restore our earlier saved registers
00AD:                   
00AD: A684                       lda   ,x               get first char
00AF: 810D                       cmpa  #C$CR            CR?
00B1: 102701C2                   lbeq  ShowHelp         if so, no parameters... show help and exit
