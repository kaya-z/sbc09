0000:                   ********************************************************************
0000:                   * Init - NitrOS-9 Configuration module
0000:                   *
0000:                   * $Id$
0000:                   *
0000:                   * Edt/Rev  YYYY/MM/DD  Modified by
0000:                   * Comment
0000:                   * ------------------------------------------------------------------
0000:                   * 204      1998/10/12  Boisy G. Pitre
0000:                   * Original OS-9 L2 Tandy distribution.
0000:                   *
0000:                   * 205      1998/10/20  Boisy G. Pitre
0000:                   * Added CC3IO and Clock sections.
0000:                   *
0000:                   * 205r2    1998/10/20  Boisy G. Pitre
0000:                   * Removed clock information from here.
0000:                   *
0000:                   *   1      2003/01/08  Boisy G. Pitre
0000:                   * Restarted edition number back to 1, removed CMDS/cc3go reference and
0000:                   * just have cc3go so that in certain cases, cc3go can be in the bootfile,
0000:                   * and so that ROMmed systems don't have to have a special init module.
0000:                   *
0000:                   *          2003/11/05  Robert Gault
0000:                   * Corrected CC3IO info regards mouse. Changed from fcb to fdb low res/ right
0000:                   * Corrected OS9Defs to match.
0000:                   *
0000:                   *          2006/07/06   P.Harvey-Smith.
0000:                   * Conditionally excluded port messages on Dragon Alpha, due to insufficient
0000:                   * space !
0000:                   *
0000:                   
0000:                            nam   Init
0000:                            ttl   NitrOS-9 Configuration module
0000:                   
0000:                            ifp1  
0000:                            use   defsfile
0000:                            IFGT  Level-1
0000:                            use    cocovtio.d
0000:                            ENDC
0000:                            endc  
0000:                   
00C0:                   tylg     set   Systm+$00
0080:                   atrv     set   ReEnt+rev
0000:                   rev      set   $00
0001:                   edition  set   1
0000:                   
0000:                   *
0000:                   * Usually, the last two words here would be the module entry
0000:                   * address and the dynamic data size requirement. Neither value is
0000:                   * needed for this module so they are pressed into service to show
0000:                   * MaxMem and PollCnt. For example:
0000:                   * $0FE0,$0015 means
0000:                   * MaxMem = $0FE000
0000:                   * PollCnt = $0015
0000:                   *
0000: 87CD006D002AC080           mod   eom,name,tylg,atrv,$0FE0,$0015
0009: 0FE00015
0000:                   
0000:                   ***** USER MODIFIABLE DEFINITIONS HERE *****
0000:                   
0000:                   *
0000:                   * refer to
0000:                   * "Configuration Module Entry Offsets"
0000:                   * in os9.d
0000:                   *
000D:                   start    equ   *
000D: 27                         fcb   $27        entries in device table
000E: 002F                       fdb   DefProg    offset to program to fork
0010: 0034                       fdb   DefDev     offset to default disk device
0012: 0037                       fdb   DefCons    offset to default console device
0014: 003C                       fdb   DefBoot    offset to boot module name
0016: 01                         fcb   $01        write protect flag (?)
0017: 02                         fcb   Level      OS level
0018: 01                         fcb   NOS9VER    OS version
0019: 00                         fcb   NOS9MAJ    OS major revision
001A: 01                         fcb   NOS9MIN    OS minor revision
001B:                            IFNE  H6309
001B:                            fcb   Proc6309+CRCOff     feature byte #1
001B:                            ELSE
001B: 00                         fcb   CRCOff     feature byte #1
001C:                            ENDC
001C: 00                         fcb   $00        feature byte #2
001D: 0040                       fdb   OSStr
001F: 005D                       fdb   InstStr
0021: 00000000                   fcb   0,0,0,0    reserved
0025:                   
0025:                            IFGT  Level-1
0025:                   * CC3IO section
0025: 01                         fcb   Monitor    monitor type
0026: 0001                       fcb   0,1        mouse info, low res right mouse
0028: 1E                         fcb   $1E        key repeat start constant
0029: 03                         fcb   $03        key repeat delay constant
002A:                            ENDC
002A:                   
002A: 496E69F4          name     fcs   "Init"
002E: 01                         fcb   edition
002F:                   
002F: 53797347EF        DefProg  fcs   "SysGo"
0034:                            IFNE   TN9K
0034: 2F44B0            DefDev   fcs   "/D0"
0037:                            ELSE
0034:                   DefDev   fcs   "/V0"
0037:                            ENDC
0037: 2F546572ED        DefCons  fcs   "/Term"
003C: 426F6FF4          DefBoot  fcs   "Boot"
0040:                   
0040:                   *
0040:                   * The DragonAlpha is so pushed for boot track space, that we have to exclude these
0040:                   * messages !
0040:                   *
0040:                   
0040:                            IFEQ  dalpha
0040:                   OSStr    equ   *
0040: 4E6974724F532D39           fcc   "NitrOS-9/"
0049:                            IFNE  H6309
0049:                            fcc   /6309 /
0049:                            ELSE
0049: 3638303920                 fcc   /6809 /
004E:                            ENDC
004E: 4C6576656C20               fcc   /Level /
0054: 32                         fcb   '0+Level
0055: 2056                       fcc   / V/
0057: 31                         fcb   '0+NOS9VER
0058: 2E                         fcc   /./
0059: 30                         fcb   '0+NOS9MAJ
005A: 2E                         fcc   /./
005B: 31                         fcb   '0+NOS9MIN
005C: 00                         fcb   0
005D:                   
005D:                   InstStr  equ   *
005D:                   * sim09 / sbc09 additions: the name of the machine, set with a09 -D TN9K or -D SIM09
005D:                            IFNE   TN9K
005D: 54616E67204E616E           fcc    "Tang Nano 9K"
0066: 20394B
0069:                            ELSE
0069:                            IFNE   SIM09
0069:                            fcc    "sim09 simulator"
0069:                            ELSE
0069:                            IFNE   coco1
0069:                            fcc    "Radio Shack Color Computer"
0069:                            ELSE
0069:                            IFNE   deluxe
0069:                            fcc    "Deluxe Color Computer"
0069:                            ELSE
0069:                            IFNE   coco2
0069:                            fcc    "Radio Shack Color Computer 2"
0069:                            ELSE
0069:                            IFNE   coco2b
0069:                            fcc    "Tandy Color Computer 2"
0069:                            ELSE
0069:                            IFNE   coco3
0069:                            fcc    "Tandy Color Computer 3"
0069:                            ELSE
0069:                            IFNE   tano
0069:                            fcc    "Tano Dragon (US)"
0069:                            ELSE
0069:                            IFNE   d64
0069:                            fcc    "Dragon 64 (UK)"
0069:                            ELSE
0069:                            IFNE   dalpha
0069:                            fcc    "Dragon Alpha"
0069:                            ELSE
0069:                            IFNE   atari
0069:                            fcc    "Atari XL/XE"
0069:                            ELSE
0069:                            IFNE   mc09
0069:                            fcb    $1B                       text in bright blue
0069:                            fcc    "[94mMulticomp09"
0069:                            fcb    $1B
0069:                            fcc    "[0m"
0069:                            ELSE
0069:                            IFNE   coco3fpga
0069:                            fcc    "Gary Becker's Coco3FPGA"
0069:                            ELSE
0069:                            IFNE   corsham
0069:                            fcc    "Corsham 6809"
0069:                            ELSE
0069:                            fcc    "Unknown Machine"
0069:                            ENDC                             match IFNE corsham
0069:                            ENDC                             match IFNE coco3fpga
0069:                            ENDC                             match IFNE mc09
0069:                            ENDC                             match IFNE atari
0069:                            ENDC                             match IFNE dalpha
0069:                            ENDC                             match IFNE d64
0069:                            ENDC                             match IFNE tano
0069:                            ENDC                             match IFNE coco3
0069:                            ENDC                             match IFNE coco2b
0069:                            ENDC                             match IFNE coco2
0069:                            ENDC                             match IFNE delux
0069:                            ENDC                             match IFNE coco1
0069:                            ENDC                             match IFNE SIM09
0069:                            ENDC                             match IFNE TN9K
0069: 00                         fcb   0     null-terminate the name string
006A:                            ELSE
006A:                   * DragonAlpha
0040:                   OSStr    equ   *
005D:                   InstStr  equ   *
006A:                            fcb   0     null-length string
006A:                            ENDC                             match IFEQ dalpha
006A:                   
006A: E01D2C                     emod
006D:                   eom      equ   *
006D:                            end
