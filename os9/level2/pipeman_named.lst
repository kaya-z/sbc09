0552:                   *   CC=EQ if no pipes.
0552:                   *
0552:                   
0552: 3416              SizDirP  pshs  X,D
0554:                   
0554: 5F                         clrb             ;Clear count of pipes
0555: AE23                       ldx   PD.Dev,Y
0557: AE02                       ldx   V$Stat,X   ;Point at static storage
0559: AE06                       ldx   V.List,X   ;Get head of linked list
055B: 2705                       beq   GotCnt
055D:                   
055D:                   *   There are some pipes.  Count them.
055D:                   
055D: 5C                PCount   incb  
055E: AE02                       ldx   PP.Next,X  ;Track down linked list
0560: 26FB                       bne   PCount
0562:                   
0562:                   *   Now Reg-B = pipe count.  Need 32 bytes per pipe.
0562:                   
0562: 5C                GotCnt   incb             ;Add one for us!
0563: 8620                       lda   #32
0565: 3D                         mul   
0566: EDA81E                     std   PD.QSiz,Y  ;Set element count for this pipe
0569: 8601                       lda   #1
056B: A7A821                     sta   PD.ESiz,Y  ;Set element size to 1 byte
056E:                   
056E: 3596                       puls  D,X,PC
0570:                   
0570:                   *
0570:                   *   Fill pipe buffer with directory data.
0570:                   *
0570:                   *   The data is organized like an RBF directory:
0570:                   *
0570:                   *   Offset      Data
0570:                   *   --------    --------------------------------
0570:                   *   $00-$1C     Pipe name
0570:                   *   $1D         DAT task number of pipe buffer
0570:                   *   $1E-$1F     Address of pipe buffer in task
0570:                   *
0570:                   *
0570: 3456              FilDirP  pshs  U,X,D
0572:                   
0572: AE23                       ldx   PD.Dev,Y
0574: AE02                       ldx   V$Stat,X   ;Point at static storage
0576: AE06                       ldx   V.List,X   ;Get head of linked list
0578: 2722                       beq   GotFil
057A:                   
057A:                   *   Write data for pipe buffer @X to pipe with PD @Y
057A:                   
057A: EE00              FD000    ldu   PP.PD,X    ;Point at PD for pipe to be dumped
057C: 33C823                     leau  PD.Name,u
057F: C61D                       ldb   #NameMax
0581:                   
0581: A6C0              FD001    lda   ,u+        ;Write pipe name
0583: 8D19                       bsr   QWrite
0585: 5A                         decb  
0586: 26F9                       bne   FD001
0588:                   
0588: DE4A                       ldu   <D.SysPrc  ;Get system DAT image number
058A: A646                       lda   P$Task,u
058C: 8D10                       bsr   QWrite
058E:                   
058E: 3410                       pshs  X          ;Get pipe buffer pointer
0590: A6E0                       lda   ,S+
0592: 8D0A                       bsr   QWrite
0594: A6E0                       lda   ,S+
0596: 8D06                       bsr   QWrite
0598:                   
0598:                   *   Advance to next pipe buffer
0598:                   
0598: AE02                       ldx   PP.Next,X
059A: 26DE                       bne   FD000
059C:                   
059C:                   *   All done.  Restore regs & exit
059C:                   
059C: 35D6              GotFil   puls  D,X,U,PC
059E:                   
059E:                   *   Byte saver
059E:                   
059E: 16FF54            QWrite   lbra  DoWrite
05A1:                   
05A1:                   *
05A1:                   *   Immortal entry point
05A1:                   *
05A1: 43                Immort   coma  
05A2: C226                       sbcb  #38
05A4: 54                         lsrb  
05A5: 42                         fcb   $42        ;SBCB op-code
05A6:                   
05A6:                   *   Fall through to SS.FD processing
05A6:                   
05A6:                   *
05A6:                   *   Routine to process SS.FD call on an open pipe.
05A6:                   *   Creates a pseudo-FD in the user's buffer (@R$X).
05A6:                   *   Desired byte count in R$Y.
05A6:                   *
05A6:                   *   The pseudo-file descriptor sector includes the following:
05A6:                   *
05A6:                   *   Offset      Description
05A6:                   *   --------    --------------------------------------
05A6:                   *   $00         Attributes
05A6:                   *   $01-$02     Owner's *PROCESS* ID
05A6:                   *   $03-$07     Zeros (date of last access)
05A6:                   *   $08         Use count
05A6:                   *   $09-$0C     Number of items queued
05A6:                   *   $0D-$0F     Zeros (creation date)
05A6:                   *   $10-$FF     Zeros (segment list -- at least 5 zeros needed)
05A6:                   *
05A6:                   
05A6: 3476              DoSSFD   pshs  D,X,Y,U
05A8:                   
05A8: C615                       ldb   #(16+5)    ;Clear data on stack
05AA: 6FE2              SSFD01   clr   ,-S
05AC: 5A                         decb  
05AD: 26FB                       bne   SSFD01
05AF:                   
05AF:                   *   Set attributes
05AF: A621                       lda   PD.Mod,Y
05B1: A760                       sta   FD.ATT,S
05B3:                   
05B3:                   *   Set owner's process ID
05B3: A6A81C                     lda   PD.Own,Y
05B6: A762                       sta   (FD.OWN+1),S
05B8:                   
05B8:                   *   Set use count
05B8: A622                       lda   PD.CNT,Y
05BA: A768                       sta   FD.LNK,S
05BC:                   
05BC:                   *   Set queue count
05BC:                   
05BC: ECA81A                     ldd   PD.BCNT,Y
05BF: ED6B                       std   (FD.SIZ+2),S
05C1:                   
05C1:                   *   Now copy the data into the caller's buffer
05C1:                   
05C1: 9E4A                       ldx   <D.SysPrc  ;Pointer to our PD
05C3: A606                       lda   P$Task,X   ; get system's DAT image # (source)
05C5: 9E50                       ldx   <D.Proc    ;Pointer to caller's PD
05C7: E606                       ldb   P$Task,X   ; get caller's DAT image # (dest)
05C9: 10AE46                     ldy   R$Y,U      ;Byte count
05CC: 3060                       leax  0,S        ;Source address
05CE: EE44                       ldu   R$X,U      ;Destination address
05D0: 103F38                     os9   F$Move     ;Do the move
05D3:                   
05D3:                   *   All done.
05D3:                   
05D3: 32E815                     leas  (16+5),S
05D6: 35F6                       puls  U,X,Y,D,PC
05D8:                   
05D8:                            ENDC  
05D8:                   
05D8: 684C04                     emod  
05DB:                   
05DB:                   MODSIZE  equ   *
05DB:                   
05DB:                            end   
