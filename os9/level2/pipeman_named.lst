000D: 506970654D61EE    MODNAM   fcs   "PipeMan"
0014: 01                         fcb   edition
0015:                   
0015:                   *   Jump table
0015:                   
0015: 160024            JmpTbl   lbra  Create
0018: 16003B                     lbra  Open
001B: 1601EA                     lbra  MakDir
001E: 1601E7                     lbra  ChgDir
0021: 160227                     lbra  Delete
0024: 16027A                     lbra  Seek
0027: 160359                     lbra  Read
002A: 1603E3                     lbra  Write
002D: 160347                     lbra  ReadLn
0030: 1603D0                     lbra  WriteLn
0033: 16026D                     lbra  GetStt
0036: 1602C5                     lbra  SetStt
0039: 1601D0                     lbra  Close
003C:                   
003C:                            page  
003C:                   *
003C:                   *   Create a named or anonymous pipe
003C:                   *
003C:                   *   The size of the queue is determined by examining
003C:                   *   the path descriptor, since this information has
003C:                   *   been copied there from the device descriptor.
003C:                   *
003C:                   *   Reg-U points to stacked registers of user.
003C:                   *   Reg-Y points to path descriptor
003C:                   *
003C:                   *   If success, carry clear and X points to pipe buffer
003C:                   *
003C:                   
003C:                   *   Create function allows user to override both element
003C:                   *   count and element size.  Override is enabled if if bit
003C:                   *   5 of the access mode is set.  For override, if MS bit
003C:                   *   of Reg-Y is clear, just use Reg-Y as queue element
003C:                   *   count.  If MS bit of Reg-Y is set, use LS byte of
003C:                   *   Reg-Y as element size ($00 = no change) and bottom 7
003C:                   *   bits of MS byte of Reg-Y as element count ($00 = no change)
003C:                   
003C:                   Create   equ   *
003C:                   
003C: A641                       lda   R$A,U      ;Get access mode
003E: 8520                       bita  #CInit
0040: 2714                       beq   Open
0042:                   
0042:                   *   Handle queue size override
0042:                   
0042: EC46                       ldd   R$Y,U      ;Get queue size initializer
0044: 2A0D                       bpl   SetCnt     ; (branch if just setting count)
0046:                   
0046:                   *   Set element size and count
0046:                   
0046: 5D                         tstb  
0047: 2703                       beq   Creat00    ; (branch if using default size)
0049:                   
0049: E7A821                     stb   PD.ESiz,Y  ;Reg-B = size of each element
004C:                   
004C: 847F              Creat00  anda  #$7F
004E: 2706                       beq   Open       ; (branch if using default count)
0050:                   
0050: 1F89                       tfr   a,B
0052: 4F                         clra  
0053:                   
0053:                   *   Set number of elements in queue from Reg-D
0053:                   
0053: EDA822            SetCnt   std   PD.ECnt,Y  ;Reg-D = number of elements
0056:                   
0056:                   *   Enter here for normal OPEN
0056:                   
0056:                   Open     equ   *
0056:                   
0056:                   *   Move number of elements in queue to make room for name
0056:                   
0056: ECA822                     ldd   PD.ECnt,Y
0059: EDA81E                     std   PD.QSiz,Y
005C:                   
005C:                   *   Parse pathname
005C:                   
005C: 5F                         clrb             ;Assume anonymous pipe
005D: 4F                         clra             ;Assume not 1st pipe
005E: AE44                       ldx   R$X,U      ;Point at file name in user's space
0060: 3476                       pshs  U,Y,X,D    ;Save file name, PD, reg. base, 1st & anon flag
0062:                   
0062:                   *       Caller's Regs Ptr
0062:                   *       PD Ptr
0062:                   *       Path name uptr
0062:                   *       Named flag
0062:                   *  SP-> First flag
0062:                   
0062: 103F10                     os9   F$PrsNam   ;Error if driver name (e.g. /pipe) invalid
0065: 2565                       bcs   BadName
0067:                   
0067:                   *   See if named or anonymous pipe requested.
0067:                   
0067: 170194                     lbsr  GtNext     ;Return CC=MI if at end of path name
006A: 812F                       cmpa  #'/
006C: 2712                       beq   HasName
006E:                   
006E:                   *   /pipe____
006E:                   *    X   Y
006E:                   *   Pipe is anonymous -- set up dummy name in PD.
006E:                   *   Stack must match the named pipe setup
006E:                   
006E: 1F21              NotName  tfr   Y,X        ;Skip any trailing blanks
0070: 103F10                     os9   F$PrsNam   ; (should return carry set)
0073: CC0001                     ldd   #1         ;Length of dummy name
0076: 3436                       pshs  Y,X,D
0078:                   
0078: 10AE6A                     ldy   10,S       ;Get PD pointer
007B: 6FA823                     clr   PD.Name,Y  ; and set dummy name
007E:                   
007E: 2038                       bra   GoCheck
0080:                   
0080:                   *   /pipe/foo____
0080:                   *    X   Y
0080:                   *   Pipe is named -- check length and flag on stack
0080:                   
0080: 1F21              HasName  tfr   Y,X
0082: 103F10                     os9   F$PrsNam   ;Scan off the name
0085: 2545                       bcs   BadName
0087:                   
0087: C11D                       cmpb  #NameMax   ;Check length of name
0089: 2241                       bhi   BadName
008B:                   
008B:                   *   Length OK.  X points to start of name, Y to end of name,
008B:                   *   B has name length. 
008B:                   *   Save registers & length, and do final parse to skip white
008B:                   
008B: 6361                       com   1,S        ;Set "named" flag
008D: 4F                         clra  
008E: 3436                       pshs  Y,X,D
0090:                   
0090: 1F21                       tfr   Y,X
0092: 103F10                     os9   F$PrsNam   ;Error if trying for pipe subdirectory
0095: 2433                       bcc   BadNam2
0097:                   
0097:                   *   /pipe/foo____
0097:                   *            X   Y
0097:                   *   Need to get the pipe name into our address space
0097:                   *   Use the PD for a temporary buffer.
0097:                   
0097: 9E50              NameOK   ldx   <D.Proc    ;Pointer to caller's PD
0099: A606                       lda   P$Task,X   ; get caller's DAT image #
009B: 9E4A                       ldx   <D.SysPrc  ;Pointer to our PD
009D: E606                       ldb   P$Task,X   ; get system's DAT image #
009F: 10AE60                     ldy   0,S        ;Byte count
00A2: AE62                       ldx   2,S        ;Source address
00A4: EE6A                       ldu   10,S       ;Get PD pointer and convert to . . .
00A6: 33C823                     leau  PD.Name,U  ;Destination address
00A9: 170499                     lbsr  MovSet     ;Move block, set MSB of last byte.
00AC:                   
00AC:                   *   Wow!  Everybody's in the same address space now.
00AC:                   
00AC:                   *   Since this is a named pipe, force mode to UPDATE.
00AC:                   *   Also, do not permit DIR. access
00AC:                   
00AC: AE6A                       ldx   10,S
00AE: A601                       lda   PD.MOD,X
00B0: 8580                       bita  #DIR.
00B2: 2616                       bne   BadNam2
00B4:                   
00B4: 8A03                       ora   #(READ.+WRITE.)
00B6: A701                       sta   PD.MOD,X
00B8:                   
00B8:                   *   See if this is an existing pipe.  To do this, we
00B8:                   *   must get the linked list head pointer from the
00B8:                   *   device driver's static storage.
00B8:                   *
00B8:                   *   Stack looks like this:
00B8:                   *
00B8:                   *   C   2   Sysmap Reg Pointer
00B8:                   *   A   2   Sysmap PD Pointer
00B8:                   *   8   2   Usrmap Path name pointer
00B8:                   *   7   1   Named pipe flag
00B8:                   *   6   1   First pipe flag
00B8:                   *   4   2   Usrmap Pipe name end pointer
00B8:                   *   2   2   Usrmap Pipe name start pointer
00B8:                   *   0   2   Name length
00B8:                   *   sp->
00B8:                   
00B8: AE6A              GoCheck  ldx   10,S       ;Get PD pointer
00BA: AE03                       ldx   PD.DEV,X   ;Get device table pointer
00BC: EE02                       ldu   V$Stat,X   ;Get static storage pointer
00BE: AE46                       ldx   V.List,U   ;Get pointer to head of pipe bfr linked list
00C0: 2614                       bne   Not1st     ; (reg-X = $0000 if no previous pipes)
00C2:                   
00C2:                   *   This is the 1st pipe for this descriptor.
00C2:                   *   Reg-X = $0000
00C2:                   *   Set flag and process as a new pipe.
00C2:                   
00C2: 6366                       com   6,S        ;This is the first pipe
00C4: 2032                       bra   NewPipe    ;This is a new pipe
00C6:                   
00C6:                   *   No time like the present for some error handlers
00C6:                   
00C6:                   *   Generic error, cleaning stack
00C6:                   
00C6: 3268              BadXit2  leas  8,S
00C8: 43                         coma             ;Set carry
00C9: 39                         rts   
00CA:                   
00CA:                   *   Bad Pathname -- 2 versions, depending on
00CA:                   *   how much junk is on the stack.
00CA:                   
00CA: 3266              BadNam2  leas  6,S        ;Clean stack
00CC: C6D7              BadName  ldb   #E$BPNam
00CE: 20F6                       bra   BadXit2
00D0:                   
00D0:                   *   Not Enough System RAM
00D0:                   
00D0: C6ED              TooBig   ldb   #E$NoRAM
00D2: 3266              BadExit  leas  6,S        ;Clean stack
00D4: 20F0                       bra   BadXit2
00D6:                   
00D6:                   *   Look up the pipe name, unless the pipe is anonymous.
00D6:                   *
00D6:                   *   Reg-U points to driver static storage.
00D6:                   *   Reg-X points to next pipe buffer to check.
00D6:                   
00D6: 6D67              Not1st   tst   7,S        ;Unnamed pipes are always new
00D8: 271E                       beq   NewPipe
00DA:                   
00DA: 10AE6A                     ldy   10,S       ;point at PD
00DD: 31A823                     leay  PD.Name,Y  ; then point at name in PD
00E0:                   
00E0:                   *   Main loop.  Always at least 1 pipe buffer to check first time through.
00E0:                   *   Reg-X points to buffer to check, or $0000 if none.
00E0:                   *   Reg-Y points to desired pipe name.
00E0:                   
00E0: 3410              ChkLoop  pshs  X
00E2: AE00                       ldx   PP.PD,X    ;Point at PD for this pipe buffer
00E4: 308823                     leax  PD.Name,X  ; and then point at name stored in PD
00E7: 1700DC                     lbsr  Compare
00EA: 3510                       puls  X
00EC: 10270088                   lbeq  OldPipe    ; (got a match)
00F0:                   
00F0: EC02                       ldd   PP.Next,X  ;Don't fall off the edge
00F2: 2704                       beq   NewPipe    ; (end of list)
00F4:                   
00F4: 1F01                       tfr   D,X        ;Advance to next buffer
00F6: 20E8                       bra   ChkLoop
00F8:                   
00F8:                   *   Pipe name not found.  Create a new pipe.
00F8:                   *
00F8:                   *   Reg-U points to driver static storage.
00F8:                   *   Reg-X points to last pipe buffer checked ($0000 if 1st pipe)
00F8:                   
00F8: 10AE6A            NewPipe  ldy   10,S       ;Get PD pointer
00FB:                   
00FB:                            IFEQ  (PIPEDIR-YESDIR)
00FB: A621                       lda   PD.MOD,Y   ;Check pipe attributes
00FD: 8580                       bita  #DIR.
00FF: 2703                       beq   NEWP1
0101:                   
0101:                   *   Initialize pipe characteristics for DIR. bit set
0101:                   
0101: 17044E                     lbsr  SizDirP
0104:                   *         beq    XYZZY       ;Special if no pipes created
0104:                            ENDC  
0104:                   
0104:                   *   Normal (non-dir) processing
0104:                   
0104: ECA81E            NewP1    ldd   PD.QSiz,Y  ;Get max element count
0107: 260C                       bne   DoNew      ; (graceful operation if no count)
0109:                   
0109:                   *   Default pipe parameters if none in PD.
0109:                   
0109: CC0100                     ldd   #$0100     ;Assume 256 byte buffer, 1 byte element
010C: A7A821                     sta   PD.ESiz,Y  ;Reg-A = 1
010F: 830008                     subd  #PP.Data   ;Compute elements for total size = 256
0112: EDA81E                     std   PD.QSiz,Y  Use parameters in PD
0115:                   
0115: 1700C6            DoNew    lbsr  ECtoBC     ;Convert element count to byte count in D
0118: 25B6                       bcs   TooBig     ; (carry set if too big)
011A:                   
011A:                   *   Carry has exit status
011A:                   *   Reg-D = # bytes for queue, w/o overhead
011A:                   *   Reg-X = previous buffer
011A:                   *   Reg-U = driver static storage
011A:                   
011A: 1F32                       tfr   U,Y        ;Save static storage pointer
011C:                   
011C: C30008                     addd  #PP.Data   ;Add in overhead
011F: 25AF                       bcs   TooBig
0121:                   
0121: 3406                       pshs  D          ;Save buffer size
0123: 103F28                     os9   F$SrqMem   ;Attempt to allocate buffer
0126: 3506                       puls  D          ;Recover size, clean stack, lose error msg
0128: 25A6                       bcs   TooBig
012A:                   
012A:                   *   Found enough memory for pipe buffer.
012A:                   *
012A:                   *   Pointer in Reg-U
012A:                   *   Size in Reg-D
012A:                   *   Previous buffer in Reg-X.
012A:                   *   Driver static storage in Reg-Y.
012A:                   *
012A:                   *   Initialize the buffer
012A:                   
012A: 3446                       pshs  U,D        ;Save buffer pointer & size
012C:                   
012C:                   *   Clear pipe buffer header
012C:                   
012C: C608                       ldb   #PP.Data   ;Size of header
012E: 6FC0              ClrBuf   clr   ,U+
0130: 5A                         decb  
0131: 26FB                       bne   ClrBuf
0133:                   
0133: 3546                       puls  D,U
0135:                   
0135:                   *   Initialize path descriptor and other fields of pipe buffer
0135:                   *   for new pipe.
0135:                   *
0135:                   *   Pointer in Reg-U
0135:                   *   Size in Reg-D
0135:                   *   Previous buffer in Reg-X.
0135:                   *   Driver static storage in Reg-Y.
0135:                   *
0135:                   *   IOMan has already prefilled the PD to $00 and 
0135:                   *   has set PD.CNT for this path to 1.
0135:                   
0135: 3430                       pshs  Y,X        ;Save static storage pointer & prev.buff
0137:                   
0137: 10AE6E                     ldy   (4+10),S   ;Get PD pointer to Reg-Y
013A: 10AF40                     sty   PP.PD,U    ;Save pointer to PD in pipe buffer
013D:                   
013D: 30CB                       leax  D,U        ;Point to end of pipe.buff + 1
013F: AFA812                     stx   PD.End,Y
0142:                   
0142: 3048                       leax  PP.Data,U  ;Initial Next in & Next out pointers
0144: AFA814                     stx   PD.NxtI,Y
0147: AFA816                     stx   PD.NxtO,Y
014A:                   
014A: 9E50                       ldx   <D.Proc    ;Save ID of original creator
014C: A600                       lda   P$ID,X
014E: A7A81C                     sta   PD.Own,Y
0151:                   
0151: 3530                       puls  Y,X        ;Recover static storage pointer and prev.buff
0153:                   
0153: AF44                       stx   PP.Prev,U  ;Save address of previous buffer ($0 if none)
0155: 2604                       bne   LinkIn     ; (branch if this isn't the 1st pipe)
0157:                   
0157:                   *   Special -- this is the first pipe.
0157:                   *   Set PP.Next to $0000 and store buffer address in device memory.
0157:                   *
0157:                   *   Reg-U = pointer to new buffer.
0157:                   *   Reg-X = $0000.
0157:                   *   Reg-Y = static storage
0157:                   
0157:                   **  Zero prefill of PP header covers this
0157:                   **        stx     PP.Next,U       ;No next buffer
0157:                   **        stx     PP.Prev,U       ;No previous buffer
0157: EF26                       stu   V.List,Y   ;Point driver static at this buffer
0159: 2012                       bra   IsAsOld
015B:                   
015B:                   *   There are other named pipes.  Link this one in correctly
015B:                   *   after the last one checked.
015B:                   *
015B:                   *   Reg-U = pointer to new buffer.
015B:                   *   Reg-X = Pointer to previous buffer.
015B:                   *   Reg-Y = static storage.
015B:                   
015B: EC02              LinkIn   ldd   PP.Next,X  ;Get old's next (could be $0000)
015D: EF02                       stu   PP.Next,X  ;Set old's next pointing at new
015F: ED42                       std   PP.Next,U  ;Set new's next where old's was
0161: AF44                       stx   PP.Prev,U  ;Set new's prev pointing at old
0163: 3416                       pshs  X,D
