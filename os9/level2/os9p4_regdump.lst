00C7: 3347                       leau  7,u        point to start of binary output area
00C9: 1F89                       tfr   a,b        space in 'b'
00CB: EDC810                     std   16,u       space out ascii char
00CE: EC63                       ldd   3,s        get register
00D0: 8D76                       bsr   getbin     convert to binary
00D2: 6D60                       tst   0,s        check byte count
00D4: 2621                       bne   reg040     skip if two bytes
00D6: C608                       ldb   #8         loop counter
00D8:                   
00D8: A648              reg030   lda   8,u        get two chars from second 8 digits
00DA: A7C0                       sta   ,u+        store in first 8 digits
00DC: 8620                       lda   #C$SPAC    get space
00DE: A747                       sta   7,u        store in second 8 digits
00E0: 5A                         decb             decrement counter
00E1: 26F5                       bne   reg030     loop back if not done
00E3: 3358                       leau  -8,u       back up to beginning of binary digit output
