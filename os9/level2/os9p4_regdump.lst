00EA: 260B                       bne   reg040     nope..skip this
00EC: C120                       cmpb  #C$SPAC    compare char with space
00EE: 2507                       blo   reg040     if lower..skip this
00F0: C17A                       cmpb  #'z        compare with last alpha char
00F2: 2203                       bhi   reg040     if higher..skip this
