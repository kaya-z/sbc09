003C: 8620                       lda   #C$SPAC    get a space
003E: C632                       ldb   #50        number of chars to clear
0040: 1F31                       tfr   u,x        set register for loop
0042:                   
0042: A780              clrloop  sta   ,x+        initialize a space
0044: 5A                         decb             decrement counter
0045: 26FB                       bne   clrloop    if more..loop back & clear another
0047: 1700BD                     lbsr  reg060     send a <cr>
004A: 308D00DF                   leax  reg080,pcr point to start of control table
004E: 4F                         clra             clear msb of register
004F: E621                       ldb   R$A,y      get register from stack
0051: 8D2D                       bsr   reg000     dump register A
0053: E622                       ldb   R$B,y      get register from stack
0055: 8D29                       bsr   reg000     dump register B
0057:                            IFNE  H6309
0057:                            ldb   R$E,y      get register from stack
0057:                            bsr   reg000     dump register E
0057:                            ldb   R$F,y      get register from stack
0057:                            bsr   reg000     dump register F
0057:                            ENDC
