0059: EC24                       ldd   R$X,y      get register from stack
005B: 8D23                       bsr   reg000     dump register X
005D: EC26                       ldd   R$Y,y      get register from stack
005F: 8D1F                       bsr   reg000     dump regisetr Y
0061: EC28                       ldd   R$U,y      get register from stack
0063: 8D1B                       bsr   reg000     dump register U
0065: E620                       ldb   R$CC,y     get register from stack
0067: 8D17                       bsr   reg000     dump register CC
0069: E623                       ldb   R$DP,y     get register from stack
