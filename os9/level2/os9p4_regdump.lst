0095: 1700E3                     lbsr  gethex     convert to hex
0098: 6D60                       tst   0,s        1 byte ?
009A: 2609                       bne   reg010     no...skip this
009C: EC42                       ldd   2,u        get 2 lsb's
009E: EDC4                       std   ,u         store in msb's
00A0: CC2020                     ldd   #C$SPAC*256+C$SPAC    get two spaces
00A3: ED42                       std   2,u        store in lsb's
00A5:                   
