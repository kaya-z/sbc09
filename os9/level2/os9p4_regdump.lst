012D:                   * Control  Table - Format is :
012D:                   *      Byte count    (0=1,1=2)
012D:                   *      Register name (Two chars)
012D:                   
012D: 00                reg080   fcb   0
012E: 6120                       fcc   /a /
0130: 00                         fcb   0
0131: 6220                       fcc   /b /
0133:                            IFNE  H6309
0133:                            fcb   0
0133:                            fcc   /e /
0133:                            fcb   0
0133:                            fcc   /f /
0133:                            ENDC
0133: 01                         fcb   1
0134: 7820                       fcc   /x /
0136: 01                         fcb   1
0137: 7920                       fcc   /y /
0139: 01                         fcb   1
013A: 7520                       fcc   /u /
013C: 00                         fcb   0
013D: 6363                       fcc   /cc/
013F: 00                         fcb   0
0140: 6470                       fcc   /dp/
0142: 01                         fcb   1
0143: 7063                       fcc   /pc/
0145: 01                         fcb   1
0146: 7320                       fcc   /s /
