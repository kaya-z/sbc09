00A8: ED44                       std   4,u        move in two spaces
00AA: 3346                       leau  6,u        point to start of decimal output buffer
00AC: EC63                       ldd   3,s        get register
00AE: 1700EB                     lbsr  getdec     convert to decimal
00B1: 6D60                       tst   0,s        is it one byte
00B3: 260D                       bne   reg020     no..skip this
00B5: EC42                       ldd   2,u        else get third & fourth chars
00B7: EDC4                       std   ,u         store as first two
00B9: A644                       lda   4,u        get fifth char
00BB: A742                       sta   2,u        store as third
00BD: CC2020                     ldd   #C$SPAC*256+C$SPAC    get two spaces
00C0: ED43                       std   3,u        store as 4th & 5th chars
00C2:                   
