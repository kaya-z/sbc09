; UZI mnemonics for memory addresses etc

U_DATA__TOTALSIZE           equ 0x0200        ; 256+256

PROGBASE                    equ 0x6C00       ; programs and data start here

; sim09 I/O page ($E000-$E1FF, see docs of the simulator)
ACIA0_STATUS		    equ 0xE000
ACIA0_DATA		    equ 0xE001
POWER			    equ 0xE00F
TIMER			    equ 0xE030
